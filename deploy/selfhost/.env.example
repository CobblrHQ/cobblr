# Self-hosted Cobblr (CLONE-AND-BUILD path) — copy to `.env` in the repo root
# and fill in.
#   cp deploy/selfhost/.env.example .env
#
# Then bring the stack up:
#   docker compose -f docker-compose.yml -f deploy/selfhost/docker-compose.selfhost.yml up -d --build
#
# NOTE: the IMAGE-BASED install (deploy/selfhost/standalone/) carries its own
# richer .env.example — the full TLS-mode matrix incl. tsnet, COBBLR_DATA_ROOT,
# COBBLR_VERSION channel pinning. Where a knob exists in both, that template is
# the canonical reference; this one stays minimal for the build-it-yourself
# path.

# ── HTTPS / your address ─────────────────────────────────────────────
# The hostname you'll open in the browser. For the recommended DuckDNS path
# this is the free subdomain you claimed, pointed at this box's LAN IP.
COBBLR_SITE_ADDRESS=your-name.duckdns.org

# DuckDNS token (https://www.duckdns.org — free, sign in, copy the token).
DUCKDNS_TOKEN=

# Optional: email Let's Encrypt uses for expiry notices.
COBBLR_ACME_EMAIL=

# Which Caddyfile to use. Default = DuckDNS (leave commented). Uncomment one:
#   ./deploy/selfhost/Caddyfile.cloudflare   → your own domain on Cloudflare DNS
#   ./deploy/selfhost/Caddyfile.internal     → fully offline, no domain (per-device CA trust)
# COBBLR_CADDYFILE=./deploy/selfhost/Caddyfile.cloudflare
# CLOUDFLARE_API_TOKEN=

# ── Secrets — GENERATE THESE, do not ship the defaults ───────────────
# Postgres password.
POSTGRES_PASSWORD=change-me
# Signing key for login sessions. Generate: openssl rand -hex 32
JWT_SECRET=
# Encrypts stored per-workspace credentials at rest. MUST be exactly 32 bytes.
# Generate: openssl rand -hex 16   (32 hex chars = 32 bytes)
# ⚠ Back this up — if you lose it, stored integration credentials are unrecoverable.
TENANT_CREDS_ENCRYPTION_KEY=

# DATABASE_URL / SUPERUSER_DATABASE_URL: must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://cobblr:change-me@db:5432/cobblr_meta
SUPERUSER_DATABASE_URL=postgres://cobblr:change-me@db:5432/postgres
POSTGRES_USER=cobblr
POSTGRES_DB=cobblr_meta

# ── First account + operator ─────────────────────────────────────────
# Open self-service signup so you can create your account on first run.
# Turn this OFF (unset / "false") once your account exists — especially if
# your instance is exposed to the public.
PUBLIC_SIGNUP_ENABLED=true

# Your email here makes that account the instance OPERATOR (super-admin): the
# /admin console that sits above every workspace — manage workspaces + users,
# instance health, sign-up invites. Comma-separated for more than one.
SUPERADMIN_EMAILS=

# ── Optional ─────────────────────────────────────────────────────────
# Built-in AI features. They need a provider key to actually do anything and
# degrade gracefully without one; set "false" for a guaranteed no-outbound
# deploy.
COBBLR_AI_ENABLED=true

# Keep modules marked `experimental` (rough, may change or be removed) out
# entirely: not loaded, not mounted, no background workers. Default off, so
# nothing ever vanishes from an existing install without you choosing it.
# COBBLR_DISABLE_EXPERIMENTAL_MODULES=true

# Barcode scanning calls third-party product catalogs when you scan. Full
# per-provider control + API keys are documented in SELF_HOSTING.md →
# Privacy. Quick knobs:
# COBBLR_SCAN_EXTERNAL_LOOKUPS=false   # no third-party barcode calls at all
# COBBLR_SCAN_GOUPC_API_KEY=           # your go-upc key → their official API
# COBBLR_SCAN_UPCITEMDB_KEY=           # your upcitemdb paid key → your own quota
# SCAN_EXPORT_DEFAULT_PHOTO_MODE=embed # inbox-export default: embed (baked-in,
#                                      # offline-safe, no public links) | link |
#                                      # none. Self-host default embed; the user
#                                      # can override per export.
