# Cobblr self-host — copy to `.env` beside docker-compose.yml and edit.
# Sections are ordered by how likely you are to touch them: 1 and 2 are the
# whole quick start; 3–5 are there when you need them.
# The setup builder fills this in for you: https://docs.cobblr.xyz/setup-builder

# ── 1. REQUIRED — the only section everyone edits ─────────────────────
# The name you'll open Cobblr at (no https://, just the name):
COBBLR_SITE_ADDRESS=cobblr.tail1234.ts.net
# Your email — this account becomes the instance operator (/admin):
SUPERADMIN_EMAILS=you@example.com
# Any strong password (e.g. openssl rand -hex 16). Blank on purpose — the
# stack refuses to start until you set it:
POSTGRES_PASSWORD=
# openssl rand -hex 32 :
JWT_SECRET=
# openssl rand -hex 16 — ⚠ BACK THIS UP, unrecoverable if lost:
TENANT_CREDS_ENCRYPTION_KEY=
# Open signup so you can create your account; set false right after,
# especially if exposing your instance to the public:
PUBLIC_SIGNUP_ENABLED=true

# ── 2. HTTPS — pick ONE block; default is Tailscale (own hostname) ────
# Easiest: the box needs NO tailscale install; MagicDNS + HTTPS must be
# enabled on the tailnet. Leave TS_AUTHKEY out to approve the box in your
# browser (on first start the caddy logs print a one-time link); set a
# reusable key only for a fully headless join.
COMPOSE_PROFILES=caddy
COBBLR_TLS_MODE=tsnet
#   TS_AUTHKEY=tskey-auth-...
# Cloudflare (your own domain on Cloudflare DNS; the name points at your box,
# so you also forward TCP 443 on your router — see the install guide):
#   COBBLR_TLS_MODE=cloudflare
#   CLOUDFLARE_API_TOKEN=
# Offline (no domain/internet; each device trusts the CA once):
#   COBBLR_TLS_MODE=internal
# Tailscale via the box's own name (run `tailscale serve --bg 8088` on the host):
#   COMPOSE_PROFILES=

# ── UPDATES — optional; off unless you list the profile ──────────────
# Add `autoupdate` to COMPOSE_PROFILES above (e.g. COMPOSE_PROFILES=caddy,autoupdate)
# and a small updater pulls newer images once a day and recreates only the
# Cobblr containers that changed. Pairs with COBBLR_VERSION=nightly.
# It checks every four hours, in UTC, so no fixed hour has to be right for
# every timezone. There is about one new build a day, so that is still about
# one restart a day.
# WATCHTOWER_SCHEDULE=0 0 8 * * *      # six fields, seconds first: a fixed hour
# WATCHTOWER_TZ=Europe/Berlin          # ...read in your zone rather than UTC
# DOCKER_API_VERSION=1.41              # raise only for a very old Docker engine

# ── 3. EMAIL — optional; skip it and login/invite links show in-app ──
# COBBLR_AUTH_EMAIL_PROVIDER=smtp        # smtp | mailgun | resend | postmark
# COBBLR_AUTH_EMAIL_FROM="Cobblr <you@example.com>"
# COBBLR_AUTH_SMTP_HOST=smtp.gmail.com   # gmail: use an app password
# COBBLR_AUTH_SMTP_PORT=587
# COBBLR_AUTH_SMTP_USER=
# COBBLR_AUTH_SMTP_PASS=
# or a transactional key instead:
# COBBLR_AUTH_MAILGUN_API_KEY=
# COBBLR_AUTH_RESEND_API_KEY=
# COBBLR_AUTH_POSTMARK_TOKEN=

# ── 4. PRIVACY — optional off-switches; defaults are fine ────────────
# COBBLR_AI_ENABLED=false
# COBBLR_SCAN_EXTERNAL_LOOKUPS=false
# COBBLR_ORDER_PAGE_READS=false       # keep stores' order page links, never read them

# The barcode network is where coverage beyond groceries, books, and music comes
# from: you get everyone else's corrections, and yours go back in. Optional, and
# never a dependency. Get a per-install key at account.cobblr.xyz.
# COBBLR_BIDB_URL=https://barcodes.cobblr.xyz
# COBBLR_BIDB_KEY=
# Experimental modules (e.g. Digital Fabrication) are still maturing, so a fresh
# public install hides them by default. Set to false to load them — they show an
# "Experimental" badge in the module picker. (Existing installs are unaffected
# unless you add this line.)
COBBLR_DISABLE_EXPERIMENTAL_MODULES=true

# ── 5. ADVANCED — rarely touched ──────────────────────────────────────
# Where ALL bind-mount data lives (Postgres, uploaded files, installed modules,
# TLS certs). Change this ONE line to relocate every mount at once — onto a data
# disk, a NAS mount, or an appdata root you already define elsewhere. Unset =
# ./data next to this file. Examples:
#   COBBLR_DATA_ROOT=/srv/cobblr
#   COBBLR_DATA_ROOT=${PATH_TO_APPDATA}/cobblr
# COBBLR_DATA_ROOT=./data
# Pin a release instead of latest (CalVer, YYYY.M.MICRO):
# COBBLR_VERSION=2026.8.0
# Loopback-bound web port (tailscale serve targets this):
# WEB_PORT=8088
# The database connection strings are DERIVED from POSTGRES_PASSWORD above —
# change the password in one place and nothing else. Only set these if you're
# pointing at an external Postgres:
# DATABASE_URL=
# SUPERUSER_DATABASE_URL=

# How long the api waits at startup for a database that is still coming up
# (crash recovery after a power cut, or a db container slower than the api),
# in milliseconds. It says so in its log every 15 s while it waits. A wrong
# password or a missing database never waits: those stop startup at once.
# COBBLR_BOOT_DB_WAIT_MS=600000

# ── Who this instance is, to other people's APIs ─────────────────────
# A few features call third-party services (filament QR lookups, book lookups).
# Those vendors ask for a way to reach whoever is running the software. This is
# YOUR address as the person hosting this instance - not Cobblr's, and not sent
# anywhere except on a call you triggered. Falls back to the first
# SUPERADMIN_EMAILS entry. With neither set, the lookups that require a contact
# address are skipped rather than sent under somebody else's name.
COBBLR_OPERATOR_EMAIL=

# ── Nightly database dumps ───────────────────────────────────────────
# Written to ${COBBLR_DATA_ROOT}/backups/. Copying the data tree alone is not a
# complete backup: a Postgres data directory copied while the server is running
# is a torn snapshot that may not restore. These dumps restore anywhere.
# A run counts as usable only above this floor, so a truncated dump cannot
# quietly evict good ones from retention. A correct dump of a brand-new install
# is around 40 KB, so the default sits well below that and far above a broken one.
BACKUP_MIN_BYTES=10000
BACKUP_DAILY_RETENTION=30
BACKUP_WEEKLY_RETENTION=12
# The hour the dump runs. It used to be "24 h
# after the backup container last started", so it moved every time you pulled
# and nobody could say when their backup ran; if you copy the dumps somewhere
# else on a schedule, the two could drift most of a day apart. Pick a quiet
# hour. A completed dump touches data/backups/last-dump, so your copy job can
# run after it. BACKUP_AT=interval keeps the old every-24-h behaviour.
BACKUP_AT=03:00
# The zone BACKUP_AT is read in, as an IANA name (Europe/Berlin,
# America/Chicago). The backup container's own clock is UTC, so leave this
# empty and 03:00 means 03:00 UTC. Set it to the zone your copy job runs in, or
# the dump can land hours before or after the copy that should pick it up. An
# unknown name refuses to start rather than quietly falling back to UTC.
BACKUP_TZ=
# The dump filename prefix: <prefix>-<UTC timestamp>.sql.gz.
BACKUP_PREFIX=cobblr

# Optional network-only shop bridge. Start compose with --profile bridge, then
# enable Server bridge for the workspace in Configuration > Devices.
COBBLR_SERVER_BRIDGE_ENABLED=false
# Loopback API port used by the host-networked server bridge.
COBBLR_BRIDGE_API_PORT=14000

# ── 6. EVERYTHING ELSE — all optional, all off or defaulted ──────────
# Every other setting this version reads, so nothing works without being
# written down. Uncomment one to use it; leave the rest alone.

# Address and sign-in
# PUBLIC_BASE_URL=                     # the address people open (with https://); emails, printed QR codes, phone pairing and sign-in links are built from it
# CORS_ALLOWED_ORIGINS=                # comma-separated origins of OTHER sites whose pages call this api; this site's own pages never need it
# SESSION_TTL_DAYS=30                  # how long a sign-in lasts
# COBBLR_OIDC_ISSUER=                  # your own OpenID Connect provider for sign-in (all three of issuer, client id, secret, or none)
# COBBLR_OIDC_CLIENT_ID=
# COBBLR_OIDC_CLIENT_SECRET=
# COBBLR_OIDC_NAME=                    # what the sign-in button calls it
# COBBLR_OIDC_SLUG=                    # the short name in its callback address
# COBBLR_OAUTH_REDIRECT_ALLOW=         # comma-separated extra redirect addresses an AI client may use to connect

# Who may join
# COBBLR_SELF_SERVE_INVITES=false      # true lets an invited person start their own workspace from the invite
# COBBLR_USERNAME_ONLY_ACCOUNTS=false  # true lets an admin add an account with a username and no email
# COBBLR_REQUIRE_EMAIL_VERIFY=false    # true requires a verified email before sign-in (needs an email sender, section 3)
# COBBLR_BLOCK_DISPOSABLE_EMAILS=false # true refuses signups from throwaway email providers
# COBBLR_SIGNUP_MAX_PER_DAY=           # new accounts this instance accepts a day
# COBBLR_SIGNUP_MAX_PER_IP_PER_DAY=    # new accounts one address may make a day
# COBBLR_CAPTCHA_PROVIDER=             # turnstile, to put a captcha on signup
# COBBLR_CAPTCHA_SITE_KEY=             # its public site key
# COBBLR_CAPTCHA_SECRET=               # its secret key
# COBBLR_CAPTCHA_REVIEW_TOKEN=         # a secret that lets one automated reviewer past the captcha
# COBBLR_RATELIMIT=                    # off turns the built-in per-address request limits off (only behind your own)

# What this instance offers
# COBBLR_PRODUCT_NAME=                 # the name people read in emails and notices (unset: Cobblr)
# COBBLR_FEATURES_ON=                  # experiments to turn on, comma-separated
# COBBLR_FEATURES_OFF=                 # features to turn off, comma-separated
# COBBLR_UPLOAD_DESIGN_MAX_MB=200      # the largest PDF or design file; set it under your proxy's request limit
# ACTIVITY_LOG_RETENTION_DAYS=         # days of activity history to keep (unset: all of it)
# COBBLR_WORKSPACE_DELETE_REAP=        # off keeps workspaces past their deletion date instead of removing them

# What one person or workspace may send in an hour
# INVITES_PER_HOUR=20
# HAND_OFFS_PER_HOUR=20
# SALES_DOCUMENT_EMAILS_PER_HOUR=20
# TEST_EMAILS_PER_HOUR=5
# NOTIFY_SEND_CAP_PER_HOUR=            # per notification channel, e.g. email=20,webhook=300

# Sharing with other Cobblrs
# COBBLR_CLOUD_URL=                    # the Cobblr cloud shares and moves go to (unset: the default one)
# COBBLR_SHARE_INVITE_DESTINATIONS=    # where an invite may open: Label=address,... in order, or self
# COBBLR_SHARE_TRUSTED_PEERS=          # comma-separated addresses of other Cobblrs you run or trust

# Phone notifications (push): this instance makes its own keys; set these only to bring your own
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY_FILE=              # a file holding the private key, never the key itself
# VAPID_SUBJECT=                       # mailto: or https: address push services may contact

# Backups to a folder or Google Drive (Settings, Backups)
# BACKUP_FS_ROOT=                      # the folder the folder destination writes to
# GOOGLE_OAUTH_CLIENT_ID=              # your own Google app, for the Drive destination
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=
# BACKUP_OAUTH_BROKER_URL=             # or another Cobblr that has a Google app, to connect Drive through it
# BACKUP_BROKER_SHARED_SECRET=         # the secret shared with that broker

# Feedback to your own Discord
# COBBLR_FEEDBACK_DISCORD_WEBHOOK=     # a webhook that receives feedback people send from the app
# COBBLR_FEEDBACK_DISCORD_ROUTES=      # per-kind webhooks, kind=webhook,...

# A public sandbox (anyone may try it for an hour, no account): off unless true
# COBBLR_TRY_SANDBOX=false
# TRY_SANDBOX_TTL_MINUTES=60
# TRY_SANDBOX_DECISION_HOURS=24        # how long a finished sandbox may still be kept
# TRY_SANDBOX_TRIAL_DAYS=14            # how long a kept sandbox stays
# TRY_SANDBOX_EXPORT_DAYS=7            # how long an emailed export is kept
# TRY_SANDBOX_MAX_LIVE=100             # every sandbox is a real database
# TRY_SANDBOX_MAX_PER_HOUR=60
# TRY_SANDBOX_MAX_PER_IP_PER_HOUR=2
# TRY_SANDBOX_SEED=household           # the example a sandbox starts with
# TRY_SANDBOX_POOL=0                   # sandboxes kept ready so arriving is instant
# COBBLR_SELFHOST_DOCS_URL=            # where the sandbox's ending points to run your own
# COBBLR_CLOUD_SIGNUP_URL=             # where it points to sign up hosted
# COBBLR_TRY_CARRY=false               # true offers to carry the sandbox to the cloud address
# COBBLR_CARRY_SOURCES=                # on the receiving side: addresses a carried sandbox may come from

# Database connections (the api sizes these to your database at boot; set only to lower them)
# COBBLR_META_POOL_MAX=10
# COBBLR_MAX_TENANT_POOLS=50
# COBBLR_TENANT_POOL_MAX=5
# COBBLR_SWEEP_POOL_CONCURRENCY=8

# Seconds between one-line memory reports in the api's log (heap, native, open workspace pools); off when unset.
# COBBLR_MEMORY_LOG_S=60
