# Cobblr self-host — copy to `.env` beside docker-compose.yml and edit.
# Sections are ordered by how likely you are to touch them: 1 and 2 are the
# whole quick start; 3–5 are there when you need them.
# The setup builder fills this in for you: https://docs.cobblr.xyz/setup-builder

# ── 1. REQUIRED — the only section everyone edits ─────────────────────
# The name you'll open Cobblr at (no https://, just the name):
COBBLR_SITE_ADDRESS=myshop.duckdns.org
# Your email — this account becomes the instance operator (/admin):
SUPERADMIN_EMAILS=you@example.com
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32 :
JWT_SECRET=
# openssl rand -hex 16 — ⚠ BACK THIS UP, unrecoverable if lost:
TENANT_CREDS_ENCRYPTION_KEY=
# Open signup so you can create your account; set false right after,
# especially if exposing your instance to the public:
PUBLIC_SIGNUP_ENABLED=true

# ── 2. HTTPS — pick ONE block; default is DuckDNS ─────────────────────
COMPOSE_PROFILES=caddy
COBBLR_TLS_MODE=duckdns
DUCKDNS_TOKEN=
# Cloudflare (your own domain on Cloudflare DNS):
#   COBBLR_TLS_MODE=cloudflare
#   CLOUDFLARE_API_TOKEN=
# Offline (no domain/internet; each device trusts the CA once):
#   COBBLR_TLS_MODE=internal
# Tailscale, own hostname (easiest: the box needs NO tailscale install; MagicDNS
# + HTTPS must be enabled on the tailnet). Two ways to join:
#   COBBLR_TLS_MODE=tsnet
#   COBBLR_SITE_ADDRESS=cobblr.tail1234.ts.net
#   TS_AUTHKEY=tskey-auth-...   # OPTIONAL. Leave it OUT to approve the box in
#                               # your browser instead: on first start the caddy
#                               # logs print a one-time link to click. Set a
#                               # reusable key here only for a fully headless join.
# Tailscale via the box's own name (run `tailscale serve --bg 8088` on the host):
#   COMPOSE_PROFILES=

# ── 3. EMAIL — optional; skip it and login/invite links show in-app ──
# COBBLR_AUTH_EMAIL_PROVIDER=smtp        # smtp | mailgun | resend | postmark
# COBBLR_AUTH_EMAIL_FROM="Cobblr <you@example.com>"
# COBBLR_AUTH_SMTP_HOST=smtp.gmail.com   # gmail: use an app password
# COBBLR_AUTH_SMTP_PORT=587
# COBBLR_AUTH_SMTP_USER=
# COBBLR_AUTH_SMTP_PASS=
# or a transactional key instead:
# COBBLR_AUTH_MAILGUN_API_KEY=
# COBBLR_AUTH_RESEND_API_KEY=
# COBBLR_AUTH_POSTMARK_TOKEN=

# ── 4. PRIVACY — optional off-switches; defaults are fine ────────────
# COBBLR_AI_ENABLED=false
# COBBLR_SCAN_EXTERNAL_LOOKUPS=false

# The barcode network is where coverage beyond groceries, books, and music comes
# from: you get everyone else's corrections, and yours go back in. Optional, and
# never a dependency. Get a per-install key at account.cobblr.xyz.
# COBBLR_BIDB_URL=https://barcodes.cobblr.xyz
# COBBLR_BIDB_KEY=
# Experimental modules (e.g. Digital Fabrication) are still maturing, so a fresh
# public install hides them by default. Set to false to load them — they show an
# "Experimental" badge in the module picker. (Existing installs are unaffected
# unless you add this line.)
COBBLR_DISABLE_EXPERIMENTAL_MODULES=true

# ── 5. ADVANCED — rarely touched ──────────────────────────────────────
# Where ALL bind-mount data lives (Postgres, uploaded files, installed modules,
# TLS certs). Change this ONE line to relocate every mount at once — onto a data
# disk, a NAS mount, or an appdata root you already define elsewhere. Unset =
# ./data next to this file. Examples:
#   COBBLR_DATA_ROOT=/srv/cobblr
#   COBBLR_DATA_ROOT=${PATH_TO_APPDATA}/cobblr
# COBBLR_DATA_ROOT=./data
# Pin a release instead of latest (CalVer, YYYY.M.MICRO):
# COBBLR_VERSION=2026.8.0
# Loopback-bound web port (tailscale serve targets this):
# WEB_PORT=8088
# The database connection strings are DERIVED from POSTGRES_PASSWORD above —
# change the password in one place and nothing else. Only set these if you're
# pointing at an external Postgres:
# DATABASE_URL=
# SUPERUSER_DATABASE_URL=

# ── Who this instance is, to other people's APIs ─────────────────────
# A few features call third-party services (filament QR lookups, book lookups).
# Those vendors ask for a way to reach whoever is running the software. This is
# YOUR address as the person hosting this instance - not Cobblr's, and not sent
# anywhere except on a call you triggered. Falls back to the first
# SUPERADMIN_EMAILS entry. With neither set, the lookups that require a contact
# address are skipped rather than sent under somebody else's name.
COBBLR_OPERATOR_EMAIL=

# ── Nightly database dumps ───────────────────────────────────────────
# Written to ${COBBLR_DATA_ROOT}/backups/. Copying the data tree alone is not a
# complete backup: a Postgres data directory copied while the server is running
# is a torn snapshot that may not restore. These dumps restore anywhere.
# A run counts as usable only above this floor, so a truncated dump cannot
# quietly evict good ones from retention. A correct dump of a brand-new install
# is around 40 KB, so the default sits well below that and far above a broken one.
BACKUP_MIN_BYTES=10000
BACKUP_DAILY_RETENTION=30
BACKUP_WEEKLY_RETENTION=12
