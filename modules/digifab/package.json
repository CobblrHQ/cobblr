{
  "name": "@cobblr/digifab",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "main": "dist/module.js",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "scripts": {
    "gen": "node scripts/gen-detectors.mjs",
    "gen:check": "node scripts/gen-detectors.mjs --check",
    "prebuild": "npm run gen",
    "build": "tsc",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cobblr/platform-contract": "workspace:*",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "kysely": "^0.27.5",
    "mqtt": "^5.10.1",
    "saxes": "^6.0.0",
    "svgpath": "^2.6.0",
    "unzipper": "^0.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/unzipper": "^0.10.11",
    "typescript": "^5.7.2"
  }
}
