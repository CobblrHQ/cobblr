{
  "id": "klipper-moonraker",
  "name": "Klipper (Moonraker)",
  "version": "1.3.0",
  "auth": { "kind": "header", "header": "X-Api-Key", "from": "apiKey" },
  "routing": false,
  "test": { "method": "GET", "path": "/printer/info" },
  "listDevices": {
    "method": "GET",
    "path": "/printer/objects/query?print_stats&extruder&heater_bed&virtual_sdcard",
    "result": "single",
    "map": {
      "id": "='moonraker'",
      "name": "='Klipper'",
      "state": {
        "from": "$.result.status.print_stats.state",
        "map": {
          "standby": "idle",
          "complete": "idle",
          "cancelled": "idle",
          "printing": "printing",
          "paused": "paused",
          "error": "error"
        }
      },
      "temps": {"nozzle": {"actual": "$.result.status.extruder.temperature", "target": "$.result.status.extruder.target"}, "bed": {"actual": "$.result.status.heater_bed.temperature", "target": "$.result.status.heater_bed.target"}},
      "progress": "$.result.status.virtual_sdcard.progress",
      "progressScale": 1
    }
  },
  "upload": {
    "method": "POST",
    "path": "/server/files/upload",
    "body": "multipart",
    "fileField": "file",
    "result": { "fileId": "$.item.path" }
  },
  "submit": {
    "method": "POST",
    "path": "/printer/print/start?filename={fileId}",
    "result": { "jobId": "={fileId}", "queued": "='true'" }
  },
  "status": {
    "method": "GET",
    "path": "/printer/objects/query?print_stats&virtual_sdcard",
    "result": {
      "state": {
        "from": "$.result.status.print_stats.state",
        "map": {
          "standby": "completed",
          "printing": "printing",
          "paused": "paused",
          "complete": "completed",
          "cancelled": "cancelled",
          "error": "failed"
        }
      },
      "progress": "$.result.status.virtual_sdcard.progress",
      "progressScale": 1,
      "message": "$.result.status.print_stats.message"
    }
  },
  "commands": {
    "pause": { "method": "POST", "path": "/printer/print/pause" },
    "resume": { "method": "POST", "path": "/printer/print/resume" },
    "cancel": { "method": "POST", "path": "/printer/print/cancel" }
  }
}
