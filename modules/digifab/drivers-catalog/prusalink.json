{
  "id": "prusalink",
  "name": "PrusaLink",
  "version": "1.5.0",
  "auth": { "kind": "header", "header": "X-Api-Key", "from": "apiKey" },
  "routing": false,
  "test": { "method": "GET", "path": "/api/version" },
  "listDevices": {
    "method": "GET",
    "path": "/api/v1/status",
    "result": "single",
    "map": {
      "id": "='prusalink'",
      "name": "='PrusaLink'",
      "state": "$.printer.state",
      "temps": {"nozzle": {"actual": "$.printer.temp_nozzle", "target": "$.printer.target_nozzle"}, "bed": {"actual": "$.printer.temp_bed", "target": "$.printer.target_bed"}},
      "progress": "$.job.progress",
      "progressScale": 100,
      "remainingSec": "$.job.time_remaining"
    }
  },
  "versions": [
    { "method": "GET", "path": "/api/version", "map": { "firmware": "$.firmware", "software": "$.server", "controller": "='PrusaLink'" } },
    { "method": "GET", "path": "/api/version", "map": { "software": "$.version" } }
  ],
  "camera": [
    { "method": "GET", "path": "/api/v1/cameras", "arrayPath": "camera_list", "enabled": "$.connected", "snapshot": "='/api/v1/cameras/snap'" }
  ],
  "upload": {
    "method": "PUT",
    "path": "/api/v1/files/usb/{filename}",
    "body": "raw",
    "contentType": "application/octet-stream",
    "result": { "fileId": "={filename}" }
  },
  "submit": {
    "method": "POST",
    "path": "/api/v1/files/usb/{fileId}",
    "result": { "jobId": "={fileId}", "queued": "='true'" }
  },
  "status": {
    "method": "GET",
    "path": "/api/v1/status",
    "result": {
      "state": {
        "from": "$.printer.state",
        "map": {
          "IDLE": "completed",
          "READY": "completed",
          "PRINTING": "printing",
          "PAUSED": "paused",
          "FINISHED": "completed",
          "STOPPED": "cancelled",
          "ERROR": "failed",
          "ATTENTION": "paused",
          "BUSY": "printing"
        }
      },
      "progress": "$.job.progress",
      "progressScale": 100
    }
  },
  "commands": {
    "pause": { "method": "PUT", "path": "/api/v1/job/{jobNum}/pause", "resolve": { "method": "GET", "path": "/api/v1/job", "vars": { "jobNum": "$.id" } } },
    "resume": { "method": "PUT", "path": "/api/v1/job/{jobNum}/resume", "resolve": { "method": "GET", "path": "/api/v1/job", "vars": { "jobNum": "$.id" } } },
    "cancel": { "method": "DELETE", "path": "/api/v1/job/{jobNum}", "resolve": { "method": "GET", "path": "/api/v1/job", "vars": { "jobNum": "$.id" } } }
  }
}
