{
  "id": "fluidnc-laser",
  "name": "FluidNC laser (direct)",
  "version": "1.1.0",
  "routing": false,
  "test": {
    "method": "GET",
    "path": "/command?commandText=%3F"
  },
  "listDevices": {
    "method": "GET",
    "path": "/command?commandText=%24I",
    "result": "single",
    "map": {
      "id": "='fluidnc'",
      "name": "='FluidNC'"
    }
  },
  "versions": [
    { "method": "GET", "path": "/command?commandText=%24I", "format": "text", "map": { "firmware": "FluidNC v([0-9][^\\s:\\]]*)", "controller": "='FluidNC'" } }
  ],
  "upload": {
    "method": "POST",
    "path": "/upload",
    "body": "multipart",
    "fileField": "myfile",
    "result": {
      "fileId": "={filename}"
    }
  },
  "submit": {
    "method": "GET",
    "path": "/command?commandText=%24SD%2FRun%3D%2F{fileId}",
    "result": {
      "jobId": "={fileId}",
      "queued": "='true'"
    }
  },
  "status": {
    "method": "GET",
    "path": "/command?commandText=%3F",
    "parse": "text",
    "result": {
      "state": {
        "from": "<([A-Za-z]+)",
        "map": {
          "Idle": "completed",
          "Run": "printing",
          "Hold": "paused",
          "Jog": "printing",
          "Home": "printing",
          "Alarm": "failed",
          "Door": "paused",
          "Check": "printing",
          "Sleep": "completed"
        }
      },
      "progress": "SD:([0-9.]+)",
      "progressScale": 100
    }
  },
  "laser": {
    "firmware": "fluidnc",
    "settings": "/command?commandText=%24%24",
    "command": "/command?commandText={command}",
    "download": "/sd/{fileId}"
  },
  "commands": {
    "pause": {
      "method": "GET",
      "path": "/command?commandText=%21"
    },
    "resume": {
      "method": "GET",
      "path": "/command?commandText=%7E"
    },
    "cancel": {
      "method": "GET",
      "path": "/command?commandText=%18"
    }
  }
}
