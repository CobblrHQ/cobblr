{
  "id": "octoprint",
  "name": "OctoPrint",
  "version": "1.4.0",
  "auth": { "kind": "header", "header": "X-Api-Key", "from": "apiKey" },
  "routing": false,
  "test": { "method": "GET", "path": "/api/version" },
  "listDevices": {
    "method": "GET",
    "path": "/api/printer",
    "result": "single",
    "map": {
      "id": "='octoprint'",
      "name": "='OctoPrint'",
      "state": "$.state.text",
      "temps": {"nozzle": {"actual": "$.temperature.tool0.actual", "target": "$.temperature.tool0.target"}, "bed": {"actual": "$.temperature.bed.actual", "target": "$.temperature.bed.target"}}
    }
  },
  "versions": [
    { "method": "GET", "path": "/api/version", "map": { "software": "$.server" } }
  ],
  "camera": [
    { "method": "GET", "path": "/api/settings", "enabled": "$.webcam.webcamEnabled", "stream": "$.webcam.streamUrl" },
    { "method": "GET", "path": "/api/settings", "stream": "$.plugins.classicwebcam.stream" }
  ],
  "upload": {
    "method": "POST",
    "path": "/api/files/local",
    "body": "multipart",
    "fileField": "file",
    "result": { "fileId": "$.files.local.name" }
  },
  "submit": {
    "method": "POST",
    "path": "/api/files/local/{fileId}",
    "body": { "command": "select", "print": true },
    "result": { "jobId": "={fileId}", "queued": "='true'" }
  },
  "status": {
    "method": "GET",
    "path": "/api/job",
    "result": {
      "state": {
        "from": "$.state",
        "map": {
          "Operational": "completed",
          "Starting": "printing",
          "Printing": "printing",
          "Paused": "paused",
          "Pausing": "paused",
          "Cancelling": "cancelled",
          "Error": "failed",
          "Offline": "failed"
        }
      },
      "progress": "$.progress.completion",
      "progressScale": 100,
      "message": "$.error"
    }
  },
  "commands": {
    "pause": { "method": "POST", "path": "/api/job", "body": { "command": "pause", "action": "pause" } },
    "resume": { "method": "POST", "path": "/api/job", "body": { "command": "pause", "action": "resume" } },
    "cancel": { "method": "POST", "path": "/api/job", "body": { "command": "cancel" } }
  }
}
