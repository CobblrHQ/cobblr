{
  "name": "@cobblr/core-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/module.js",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    },
    "./services/compile": {
      "types": "./src/services/compile.ts",
      "import": "./dist/services/compile.js"
    },
    "./services/shape": {
      "types": "./src/services/shape.ts",
      "import": "./dist/services/shape.js"
    },
    "./services/corroborate": {
      "types": "./src/services/corroborate.ts",
      "import": "./dist/services/corroborate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cobblr/platform-contract": "workspace:*",
    "express": "^4.21.2",
    "kysely": "^0.27.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2"
  }
}
