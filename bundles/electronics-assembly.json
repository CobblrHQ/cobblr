{
  "manifest": {
    "id": "cobblr.flagship.electronics-assembly",
    "version": "0.1.9",
    "name": "Electronics assembly",
    "author": "Cobblr",
    "description": "Component packages and board revisions, with stock checks, fabrication purchases, assembly kits, solder paste handling and placement stations.",
    "released_at": "2026-10-08",
    "changelog": "Export calibrated placement files, verify feeder reels and record runs at an authorized station.",
    "releases": [
      {
        "version": "0.1.9",
        "released_at": "2026-10-08",
        "notes": "Export calibrated placement files, verify feeder reels and record runs at an authorized station."
      },
      {
        "version": "0.1.6",
        "released_at": "2026-10-08",
        "notes": "Reserve assembly kits and track refrigerated paste handling against its label limits."
      },
      {
        "version": "0.1.5",
        "released_at": "2026-10-07",
        "notes": "A group's summary adds up only what adds up: a length or a weight per item is totalled as length or weight times how many you have, and a year, a size or a temperature is no longer summed."
      },
      {
        "version": "0.1.4",
        "released_at": "2026-10-06",
        "notes": "Import board revisions to check component stock and track fabrication purchases and stencils."
      },
      {
        "version": "0.1.1",
        "released_at": "2026-10-05",
        "notes": "Receive component packages by their distributor labels and track moisture exposure and counts."
      }
    ],
    "requires": [
      {
        "module": "inventory"
      },
      {
        "module": "core-scan"
      },
      {
        "module": "labels"
      },
      {
        "module": "projects"
      },
      {
        "module": "builds"
      },
      {
        "module": "purchases"
      },
      {
        "module": "machines"
      },
      {
        "module": "digifab"
      }
    ],
    "wires": [],
    "field_defs": [],
    "saved_views": [],
    "provides_instances": [
      {
        "module": "inventory",
        "instance_name": "placed-boards",
        "scan_keywords": [
          "placed PCB",
          "placed circuit board"
        ],
        "display_name": "Placed Boards",
        "glyph": "▱",
        "item_noun": "placed board",
        "qty_unit": "each",
        "faces": {
          "stock": true
        },
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "board_revision_id",
            "display_label": "Board revision",
            "type": "text",
            "position": 1
          }
        ],
        "saved_views": []
      },
      {
        "module": "machines",
        "instance_name": "assembly-machines",
        "scan_keywords": [
          "pick and place",
          "SMT machine",
          "reflow oven",
          "inspection bench"
        ],
        "display_name": "Assembly Machines",
        "glyph": "⚙",
        "item_noun": "assembly machine",
        "field_defs": [
          {
            "entity_kind": "machines:machine",
            "name": "calibration_notes",
            "display_label": "Calibration notes",
            "type": "text",
            "position": 1
          }
        ],
        "saved_views": []
      },
      {
        "module": "inventory",
        "instance_name": "solder-paste",
        "display_name": "Solder Paste",
        "glyph": "🫙",
        "item_noun": "paste jar",
        "qty_unit": "ml",
        "faces": {
          "stock": true
        },
        "paste_tracking": true,
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "lot_code",
            "display_label": "Paste lot",
            "type": "text",
            "position": 1
          },
          {
            "entity_kind": "inventory:part",
            "name": "alloy",
            "display_label": "Alloy",
            "type": "text",
            "position": 2,
            "learns": true,
            "choices": [
              "SAC305",
              "Sn63/Pb37",
              "Sn42/Bi58"
            ]
          }
        ],
        "saved_views": []
      },
      {
        "module": "projects",
        "instance_name": "board-projects",
        "display_name": "Board Projects",
        "glyph": "🔌",
        "item_noun": "board project",
        "board_revisions": {
          "package_kind": "component-packages:item",
          "blank_kind": "blank-boards:item",
          "stencil_kind": "board-stencils:item",
          "placed_kind": "placed-boards:item"
        },
        "scan_keywords": [
          "PCB project",
          "board project",
          "electronics project"
        ],
        "field_defs": [
          {
            "entity_kind": "projects:project",
            "name": "board_notes",
            "display_label": "Board notes",
            "type": "text",
            "position": 1
          }
        ],
        "saved_views": []
      },
      {
        "module": "inventory",
        "instance_name": "blank-boards",
        "display_name": "Blank Boards",
        "glyph": "▱",
        "item_noun": "blank board",
        "qty_unit": "each",
        "faces": {
          "stock": true
        },
        "scan_keywords": [
          "blank PCB",
          "bare circuit board",
          "fabricated PCB"
        ],
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "board_revision_id",
            "display_label": "Board revision",
            "type": "text",
            "position": 1
          }
        ],
        "saved_views": []
      },
      {
        "module": "inventory",
        "instance_name": "board-stencils",
        "display_name": "Board Stencils",
        "glyph": "▱",
        "item_noun": "stencil",
        "qty_unit": "each",
        "faces": {
          "stock": true
        },
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "board_revision_id",
            "display_label": "Board revision",
            "type": "text",
            "position": 1
          },
          {
            "entity_kind": "inventory:part",
            "name": "stencil_style",
            "display_label": "Style",
            "type": "text",
            "position": 2,
            "learns": false,
            "choices": [
              "framed",
              "frameless"
            ]
          }
        ],
        "saved_views": []
      },
      {
        "module": "inventory",
        "instance_name": "component-parts",
        "display_name": "Component Parts",
        "glyph": "🔌",
        "item_noun": "part",
        "qty_unit": "each",
        "faces": {
          "stock": false
        },
        "nav_group": {
          "key": "electronics-assembly",
          "label": "Components"
        },
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "mpn",
            "display_label": "Manufacturer part number",
            "type": "text",
            "field_role": "identifier",
            "position": 1
          },
          {
            "entity_kind": "inventory:part",
            "name": "package",
            "display_label": "Package",
            "type": "text",
            "position": 2,
            "learns": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "value",
            "display_label": "Value",
            "type": "text",
            "position": 3
          },
          {
            "entity_kind": "inventory:part",
            "name": "msl",
            "display_label": "Moisture sensitivity level",
            "type": "text",
            "position": 4,
            "learns": false,
            "choices": [
              "1",
              "2",
              "2a",
              "3",
              "4",
              "5",
              "5a",
              "6"
            ],
            "help": "Use the manufacturer's level. An unknown level blocks tracked packages from use."
          }
        ],
        "field_overrides": [
          {
            "entity_kind": "inventory:part",
            "name": "qty",
            "hidden": true
          }
        ],
        "saved_views": []
      },
      {
        "module": "inventory",
        "instance_name": "component-packages",
        "display_name": "Component Packages",
        "glyph": "📦",
        "item_noun": "package",
        "qty_unit": "each",
        "faces": {
          "stock": true
        },
        "nav_group": {
          "key": "electronics-assembly",
          "label": "Components"
        },
        "parent": {
          "instance": "component-parts",
          "label": "Part",
          "key_fields": [
            "manufacturer",
            "mpn"
          ],
          "copy_fields": [
            "package",
            "value",
            "msl"
          ]
        },
        "package_receiving": {
          "identity_field": "mpn",
          "storage_tracking": true
        },
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "mpn",
            "display_label": "Manufacturer part number",
            "type": "text",
            "field_role": "identifier",
            "position": 1
          },
          {
            "entity_kind": "inventory:part",
            "name": "packaging",
            "display_label": "Packaging",
            "type": "text",
            "position": 2,
            "learns": false,
            "choices": [
              "reel",
              "cut tape",
              "tray",
              "tube"
            ]
          },
          {
            "entity_kind": "inventory:part",
            "name": "lot_code",
            "display_label": "Lot code",
            "type": "text",
            "position": 3
          },
          {
            "entity_kind": "inventory:part",
            "name": "date_code",
            "display_label": "Date code",
            "type": "text",
            "position": 4
          },
          {
            "entity_kind": "inventory:part",
            "name": "attrition_pct",
            "display_label": "Attrition (%)",
            "type": "number",
            "aggregate": "none",
            "position": 5,
            "help": "Extra components consumed for setup and placement loss, rounded up to whole components."
          },
          {
            "entity_kind": "inventory:part",
            "name": "msl_floor_hours",
            "display_label": "MSL 6 label floor life (hours)",
            "type": "number",
            "aggregate": "none",
            "position": 6,
            "help": "For level 6, the label's deadline after a completed bake. Dry storage does not extend it."
          },
          {
            "entity_kind": "inventory:part",
            "name": "distributor",
            "display_label": "Distributor",
            "type": "text",
            "position": 7
          },
          {
            "entity_kind": "inventory:part",
            "name": "distributor_part_number",
            "display_label": "Distributor stock code",
            "type": "text",
            "position": 8
          },
          {
            "entity_kind": "inventory:part",
            "name": "purchase_order",
            "display_label": "Customer purchase order",
            "type": "text",
            "position": 9
          },
          {
            "entity_kind": "inventory:part",
            "name": "package_id",
            "display_label": "Distributor package ID",
            "type": "text",
            "position": 10
          }
        ],
        "field_overrides": [
          {
            "entity_kind": "inventory:part",
            "name": "qty",
            "display_label": "Components left"
          }
        ],
        "saved_views": []
      }
    ]
  }
}
