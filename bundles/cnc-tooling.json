{
  "manifest": {
    "id": "cobblr.flagship.cnc-tooling",
    "catalog": "extended",
    "version": "0.2.0",
    "name": "CNC Tooling",
    "description": "Your CNC tooling as its own table — end mills, drills, taps, reamers, inserts — by type/diameter/flutes/material, with the bin each lives in. Ships the guided Cataloging Bench app: capture an unknown tool's measurements + observations and it composes the spec for you (AI-enriched when a provider is connected).",
    "author": "Cobblr",
    "released_at": "2026-06-12",
    "changelog": "The guided Cataloging Bench: measure (caliper) → weigh (scale) → observe → photograph → bin, hands-busy, no typing — with a live edge mode that streams real readings from an on-site agent. The structured spec is composed deterministically; a best-effort multimodal AI identify enriches the name/brand from the measurements when a provider is connected. Built on two GENERIC capabilities the bench app wires together — inventory:create-item + core-scan:identify — not a bench-specific module action. See docs/product/cataloging-bench.md.",
    "requires": [
      {
        "module": "inventory"
      },
      {
        "module": "core-apps"
      },
      {
        "module": "core-scan"
      }
    ],
    "provides_instances": [
      {
        "module": "inventory",
        "instance_name": "tooling",
        "display_name": "Tooling",
        "glyph": "🔧",
        "item_noun": "tool",
        "qty_unit": "each",
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "tool_type",
            "display_label": "Type",
            "type": "text",
            "position": 1,
            "choices": [
              "End mill",
              "Drill",
              "Tap",
              "Reamer",
              "Insert",
              "Collet",
              "Other"
            ],
            "help": "What kind of tool — the table groups by this."
          },
          {
            "entity_kind": "inventory:part",
            "name": "diameter_mm",
            "display_label": "Diameter (mm)",
            "type": "number",
            "unit": "mm",
            "position": 2,
            "help": "Cutting diameter, from the calipers."
          },
          {
            "entity_kind": "inventory:part",
            "name": "shank_dia_mm",
            "display_label": "Shank (mm)",
            "type": "number",
            "unit": "mm",
            "position": 3,
            "help": "Shank diameter — the size your collet/holder needs."
          },
          {
            "entity_kind": "inventory:part",
            "name": "overall_length_mm",
            "display_label": "Overall length (mm)",
            "type": "number",
            "unit": "mm",
            "position": 4,
            "help": "Tip to end — for reach + holder clearance."
          },
          {
            "entity_kind": "inventory:part",
            "name": "flute_length_mm",
            "display_label": "Flute length (mm)",
            "type": "number",
            "unit": "mm",
            "position": 5,
            "help": "Length of cut."
          },
          {
            "entity_kind": "inventory:part",
            "name": "flute_count",
            "display_label": "Flutes",
            "type": "number",
            "position": 6,
            "help": "Number of flutes / lands."
          },
          {
            "entity_kind": "inventory:part",
            "name": "end_type",
            "display_label": "End",
            "type": "text",
            "position": 7,
            "choices": [
              "Square",
              "Ball",
              "Corner-radius",
              "Chamfer",
              "Drill point"
            ],
            "help": "Geometry of the cutting end."
          },
          {
            "entity_kind": "inventory:part",
            "name": "material",
            "display_label": "Material",
            "type": "text",
            "position": 8,
            "choices": [
              "Carbide",
              "HSS",
              "Cobalt",
              "Other"
            ],
            "help": "What the tool is made of."
          },
          {
            "entity_kind": "inventory:part",
            "name": "coating",
            "display_label": "Coating",
            "type": "text",
            "position": 9,
            "choices": [
              "Uncoated",
              "TiN",
              "TiCN",
              "TiAlN",
              "AlTiN",
              "DLC",
              "Other"
            ],
            "help": "Surface coating, if any."
          },
          {
            "entity_kind": "inventory:part",
            "name": "weight_g",
            "display_label": "Weight (g)",
            "type": "number",
            "unit": "g",
            "position": 10,
            "help": "From the scale — helps the AI tell carbide from HSS."
          },
          {
            "entity_kind": "inventory:part",
            "name": "bin",
            "display_label": "Bin",
            "type": "text",
            "position": 11,
            "help": "Where it physically lives — “Bin 1 / Comp 6”. Set at the bench."
          }
        ],
        "field_overrides": [
          {
            "entity_kind": "inventory:part",
            "name": "manufacturer",
            "display_label": "Brand"
          },
          {
            "entity_kind": "inventory:part",
            "name": "category",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "location",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "warranty",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "min_qty",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "supplier_url",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "serial_number",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "model_number",
            "hidden": true
          }
        ],
        "saved_views": [
          {
            "entity_kind": "inventory:part",
            "name": "By type",
            "view_type": "table",
            "pinned": true,
            "config": {
              "group_by": "tool_type",
              "visible_fields": [
                "title",
                "diameter_mm",
                "flute_count",
                "end_type",
                "material",
                "bin"
              ]
            }
          },
          {
            "entity_kind": "inventory:part",
            "name": "By bin",
            "view_type": "table",
            "config": {
              "group_by": "bin",
              "visible_fields": [
                "title",
                "tool_type",
                "diameter_mm",
                "material"
              ]
            }
          }
        ]
      }
    ],
    "provides_apps": [
      {
        "slug": "cataloging-bench",
        "name": "Cataloging Bench",
        "icon": "🔧",
        "pages": [
          {
            "slug": "bench",
            "title": "The bench",
            "blocks": [
              {
                "type": "custom",
                "html": "\n<style>\n  :root{--line:#23303f;--muted:#7f93a8;--accent:#3f6fb5;--bg:#0f1722;--panel:#16202d;--text:#e7eef6;--good:#4caf7d;--live:#46b06a;}\n  *{box-sizing:border-box}\n  .cb-wrap{font:14px system-ui,-apple-system,sans-serif;color:var(--text);display:flex;flex-direction:column;gap:12px}\n  .cb-conn{display:flex;align-items:center;gap:8px;font:11px ui-monospace,monospace;color:var(--muted)}\n  .cb-dot{width:9px;height:9px;border-radius:50%;background:#3a4658}\n  .cb-dot.on{background:var(--live);box-shadow:0 0 0 3px rgba(70,176,106,.18)}\n  .cb-stage{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;min-height:260px;display:flex;flex-direction:column;gap:14px}\n  .cb-step{font:11px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}\n  .cb-prompt{font-size:21px;font-weight:700;line-height:1.25}\n  .cb-sub{color:var(--muted);font-size:13px}\n  .cb-readout{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n  .cb-num{width:120px;background:#0c141d;border:1px solid var(--line);border-radius:10px;color:var(--text);font:600 26px ui-monospace,monospace;padding:8px 10px;text-align:right}\n  .cb-live{display:inline-flex;align-items:baseline;gap:8px;background:#0c141d;border:1px solid var(--live);border-radius:10px;padding:8px 14px;font:700 26px ui-monospace,monospace;color:#d7f3e2;min-width:120px;justify-content:flex-end}\n  .cb-live .src{font:10px ui-monospace,monospace;color:var(--live);letter-spacing:.1em}\n  .cb-unit{color:var(--muted);font-size:15px}\n  .cb-picks{display:flex;gap:8px;flex-wrap:wrap}\n  .cb-pick{border:1px solid var(--line);background:#0c141d;border-radius:9px;padding:8px 12px;color:var(--text);cursor:pointer;font-size:14px}\n  .cb-pick.sel{border-color:var(--accent);background:rgba(63,111,181,.18);color:#cfe0f5}\n  .cb-canvas{width:150px;height:150px;border:1px solid var(--line);border-radius:12px;background:#0c141d}\n  .cb-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n  .cb-spacer{flex:1}\n  .cb-pedal{border:none;background:var(--accent);color:#fff;border-radius:12px;padding:14px 22px;font:700 16px system-ui;cursor:pointer;display:inline-flex;align-items:center;gap:9px}\n  .cb-pedal:disabled{opacity:.5;cursor:default}\n  .cb-pedal .key{font:11px ui-monospace,monospace;background:rgba(255,255,255,.18);border-radius:5px;padding:2px 6px}\n  .cb-tape{display:flex;gap:7px;flex-wrap:wrap}\n  .cb-chip{font:11px ui-monospace,monospace;background:#0c141d;border:1px solid var(--line);border-radius:7px;padding:4px 8px;color:#aebfce}\n  .cb-chip b{color:var(--text);font-weight:700}\n  .cb-bin{display:inline-flex;align-items:center;gap:8px;background:#0c141d;border:1px solid var(--accent);border-radius:10px;padding:10px 14px;font:600 16px ui-monospace,monospace;color:#cfe0f5}\n  .cb-result{background:#0c141d;border:1px solid var(--good);border-radius:12px;padding:14px;display:flex;gap:12px;align-items:center}\n  .cb-result .nm{font-weight:700;font-size:16px}\n  .cb-log h4{font:11px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}\n  .cb-logrow{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);padding:8px 0;font-size:13px}\n  .cb-logrow .loc{margin-left:auto;font:11px ui-monospace,monospace;color:var(--accent)}\n  .cb-ai{font:10px ui-monospace,monospace;color:var(--good);border:1px solid var(--good);border-radius:5px;padding:1px 5px}\n  .cb-empty{color:var(--muted);font-size:12px}\n</style>\n<div class=\"cb-wrap\">\n  <div class=\"cb-conn\" id=\"cb-conn\"><span class=\"cb-dot\" id=\"cb-dot\"></span><span id=\"cb-conntxt\">Bench not connected — simulated readings (Phase 1).</span></div>\n  <div class=\"cb-stage\" id=\"cb-stage\"></div>\n  <div class=\"cb-tape\" id=\"cb-tape\"></div>\n  <div class=\"cb-log\">\n    <h4>// binned this session</h4>\n    <div id=\"cb-log\"><span class=\"cb-empty\">Nothing yet — run a tool through the bench.</span></div>\n  </div>\n</div>\n<script>\n(function(){\n  var stage=document.getElementById('cb-stage');\n  var tapeEl=document.getElementById('cb-tape');\n  var logEl=document.getElementById('cb-log');\n  var dotEl=document.getElementById('cb-dot');\n  var connTxt=document.getElementById('cb-conntxt');\n  var SDK=(window.cobblr||{});\n\n  var TOOL_TYPES=['End mill','Drill','Tap','Reamer','Insert'];\n  var ENDS=['Square','Ball','Corner-radius','Chamfer','Drill point'];\n  var MATERIALS=['Carbide','HSS','Cobalt'];\n  var sample=[\n    {type:'End mill',dia:6.0,oal:57,shank:6.0,flute:38,flutes:4,end:'Square',mat:'Carbide',wt:14},\n    {type:'End mill',dia:3.175,oal:38,shank:3.175,flute:12,flutes:2,end:'Ball',mat:'Carbide',wt:5},\n    {type:'Drill',dia:5.0,oal:86,shank:5.0,flute:52,flutes:2,end:'Drill point',mat:'HSS',wt:11},\n    {type:'End mill',dia:12.0,oal:83,shank:12.0,flute:26,flutes:4,end:'Corner-radius',mat:'Carbide',wt:62},\n    {type:'Tap',dia:6.0,oal:66,shank:5.0,flute:22,flutes:4,end:'Chamfer',mat:'HSS',wt:13}\n  ];\n  var sampleIdx=0;\n\n  function makeSteps(s){return [\n    {k:'caliper',chan:'caliper_mm',field:'diameter_mm',label:'cutting diameter',val:s.dia,unit:'mm'},\n    {k:'caliper',chan:'caliper_mm',field:'shank_dia_mm',label:'shank diameter',val:s.shank,unit:'mm'},\n    {k:'caliper',chan:'caliper_mm',field:'overall_length_mm',label:'overall length',val:s.oal,unit:'mm'},\n    {k:'caliper',chan:'caliper_mm',field:'flute_length_mm',label:'flute length',val:s.flute,unit:'mm'},\n    {k:'scale',chan:'scale_g',field:'weight_g',label:'weight',val:s.wt,unit:'g'},\n    {k:'observe-type',field:'tool_type',label:'what kind of tool is it?',val:s.type},\n    {k:'observe-count',field:'flute_count',label:'how many flutes / lands?',val:s.flutes},\n    {k:'observe-end',field:'end_type',label:'what is the cutting end?',val:s.end},\n    {k:'observe-mat',field:'material',label:'what is it made of?',val:s.mat},\n    {k:'photo',field:'_photo',label:'place it in the photo box'},\n    {k:'locate',field:'_bin',label:'bin it'}\n  ];}\n\n  var item=null, binSeq=0, currentPedal=null;\n  // live edge state — populated by polling the app's own KV (\"bench-live\"),\n  // which the on-site agent writes. live.on = a fresh reading was seen recently.\n  var live={on:false,caliper_mm:null,scale_g:null,pedal_seq:0,seen:0};\n\n  function nextBin(){binSeq++;var b=Math.floor((binSeq-1)/8)+1,c=((binSeq-1)%8)+1;return 'Bin '+b+' / Comp '+c;}\n\n  function start(){\n    var s=sample[sampleIdx % sample.length]; sampleIdx++;\n    item={steps:makeSteps(s),i:0,captured:{},bin:nextBin(),s:s};\n    render();\n  }\n\n  function specName(c){\n    var t=(c.tool_type||'tool').toLowerCase(), noun=t==='end mill'?'end mill':t, bits=[];\n    if(c.diameter_mm) bits.push(fmt(c.diameter_mm)+' mm');\n    if(c.flute_count) bits.push(c.flute_count+'-flute');\n    if(c.end_type && noun==='end mill') bits.push(String(c.end_type).toLowerCase());\n    if(c.material) bits.push(String(c.material).toLowerCase());\n    bits.push(noun);\n    return bits.join(' ').replace(/\\b\\w/,function(m){return m.toUpperCase();});\n  }\n  function fmt(n){return (Math.round(n*1000)/1000).toString();}\n\n  function drawTool(canvas,s){\n    var x=canvas.getContext('2d'),W=canvas.width=300,H=canvas.height=300;\n    x.clearRect(0,0,W,H);x.save();x.translate(W/2,H/2);x.rotate(-0.45);\n    var len=200, dia=Math.max(16,Math.min(54,(s.dia||6)*5)), sh=dia*0.78;\n    x.fillStyle='#7e8794';x.fillRect(-len/2,-sh/2,len*0.42,sh);\n    var grad=x.createLinearGradient(0,-dia/2,0,dia/2);\n    grad.addColorStop(0,(s.mat==='Carbide')?'#3a4350':'#5a6470');grad.addColorStop(.5,(s.mat==='Carbide')?'#aab4c2':'#c9cfd6');grad.addColorStop(1,(s.mat==='Carbide')?'#3a4350':'#5a6470');\n    x.fillStyle=grad;x.fillRect(-len*0.08,-dia/2,len*0.55,dia);\n    x.strokeStyle='rgba(10,16,24,.65)';x.lineWidth=2;\n    var n=s.flutes||4, bx=-len*0.08, bw=len*0.55;\n    for(var f=0;f<n*3;f++){var fx=bx+(f/(n*3))*bw;x.beginPath();x.moveTo(fx,-dia/2);x.lineTo(fx+dia*0.7,dia/2);x.stroke();}\n    x.fillStyle='#8b95a3';\n    if(s.end==='Ball'){x.beginPath();x.arc(bx+bw,0,dia/2,-Math.PI/2,Math.PI/2);x.fill();}\n    else if(s.end==='Drill point'){x.beginPath();x.moveTo(bx+bw,-dia/2);x.lineTo(bx+bw+dia*0.7,0);x.lineTo(bx+bw,dia/2);x.closePath();x.fill();}\n    else {x.fillRect(bx+bw-2,-dia/2,4,dia);}\n    x.restore();\n  }\n\n  function tape(){\n    var c=item?item.captured:{};\n    tapeEl.innerHTML=Object.keys(c).filter(function(k){return k[0]!=='_';}).map(function(k){\n      return '<span class=\"cb-chip\">'+k.replace(/_/g,' ').replace(' mm','').replace(' g','')+' <b>'+c[k]+'</b></span>';\n    }).join('');\n  }\n\n  function el(h){var d=document.createElement('div');d.innerHTML=h;return d.firstElementChild;}\n  function pedal(label){return '<button class=\"cb-pedal\" id=\"cb-pedal\">'+label+' <span class=\"key\">pedal ⌨ space</span></button>';}\n\n  function render(){\n    tape();\n    if(!item){\n      stage.innerHTML='<div class=\"cb-step\">// the bench</div>'+\n        '<div class=\"cb-prompt\">Ready for the next tool.</div>'+\n        '<div class=\"cb-sub\">Drop an unknown tool on the bench. We\\'ll measure it, weigh it, look at it, photograph it, and tell you which bin it goes in — no typing.</div>'+\n        '<div class=\"cb-row\"><div class=\"cb-spacer\"></div>'+pedal('Start')+'</div>';\n      bind(start); return;\n    }\n    var st=item.steps[item.i], n=item.steps.length;\n    var head='<div class=\"cb-step\">step '+(item.i+1)+' / '+n+'</div>';\n    if(st.k==='caliper'||st.k==='scale'){\n      var hw=st.k==='caliper'?'Measure the '+st.label+' with the calipers':'Place it on the scale, let it settle';\n      var liveVal=live.on?live[st.chan]:null;\n      var readout = live.on\n        ? '<div class=\"cb-live\"><span class=\"src\">🔌 LIVE</span><span id=\"cb-livev\">'+(liveVal!=null?fmt(liveVal):'—')+'</span></div><span class=\"cb-unit\">'+st.unit+'</span>'\n        : '<input class=\"cb-num\" id=\"cb-val\" value=\"'+st.val+'\"><span class=\"cb-unit\">'+st.unit+'</span>';\n      stage.innerHTML=head+'<div class=\"cb-prompt\">'+hw+'.</div>'+\n        '<div class=\"cb-sub\">'+(live.on?'Reading straight from the bench — pedal to capture it.':'Pedal when the reading is right (Phase 1: editable; a real caliper/scale feeds it in Phase 2).')+'</div>'+\n        '<div class=\"cb-readout\">'+readout+'</div>'+\n        '<div class=\"cb-row\"><div class=\"cb-spacer\"></div>'+pedal('Capture')+'</div>';\n      bind(function(){\n        var v=live.on?live[st.chan]:parseFloat(document.getElementById('cb-val').value);\n        item.captured[st.field]=(v==null||isNaN(v))?st.val:v; advance();\n      });\n    } else if(st.k.indexOf('observe')===0){\n      var opts=st.k==='observe-type'?TOOL_TYPES:st.k==='observe-end'?ENDS:st.k==='observe-mat'?MATERIALS:[1,2,3,4,5,6];\n      var cur=item.captured[st.field]!=null?item.captured[st.field]:st.val;\n      stage.innerHTML=head+'<div class=\"cb-prompt\">'+st.label+'</div>'+\n        '<div class=\"cb-sub\">In the full rig this is read from the photo box. For now, confirm what you see.</div>'+\n        '<div class=\"cb-picks\" id=\"cb-picks\">'+opts.map(function(o){return '<button class=\"cb-pick'+(o==cur?' sel':'')+'\" data-v=\"'+o+'\">'+o+'</button>';}).join('')+'</div>'+\n        '<div class=\"cb-row\"><div class=\"cb-spacer\"></div>'+pedal('Confirm')+'</div>';\n      item.captured[st.field]=cur;\n      document.getElementById('cb-picks').addEventListener('click',function(e){var b=e.target.closest('.cb-pick');if(!b)return;item.captured[st.field]=isNaN(b.dataset.v)?b.dataset.v:Number(b.dataset.v);[].forEach.call(this.children,function(c){c.classList.remove('sel');});b.classList.add('sel');});\n      bind(advance);\n    } else if(st.k==='photo'){\n      stage.innerHTML=head+'<div class=\"cb-prompt\">Place it in the photo box.</div>'+\n        '<div class=\"cb-sub\">A photo is captured + attached (for you, and for Phase-2 vision). Phase 1 renders it from the measurements.</div>'+\n        '<div class=\"cb-row\"><canvas class=\"cb-canvas\" id=\"cb-cv\"></canvas><div class=\"cb-spacer\"></div>'+pedal('Capture photo')+'</div>';\n      drawTool(document.getElementById('cb-cv'),{dia:item.captured.diameter_mm,flutes:item.captured.flute_count,end:item.captured.end_type,mat:item.captured.material});\n      bind(advance);\n    } else if(st.k==='locate'){\n      stage.innerHTML=head+'<div class=\"cb-prompt\">Done. Put it in:</div>'+\n        '<div class=\"cb-row\"><span class=\"cb-bin\">📦 '+item.bin+'</span><div class=\"cb-spacer\"></div>'+pedal('Bin it + commit')+'</div>'+\n        '<div class=\"cb-sub\">'+specName(item.captured)+' — committing…</div>';\n      bind(commit);\n    }\n  }\n\n  function advance(){item.i++; if(item.i>=item.steps.length){commit();} else render();}\n\n  // bind: register the current step's pedal action. Fired by the on-screen\n  // button, the spacebar, OR a physical foot pedal (a pedal_seq tick from live).\n  function bind(fn){\n    currentPedal=fn;\n    var p=document.getElementById('cb-pedal'); if(p)p.onclick=function(){if(currentPedal)currentPedal();};\n    window.onkeydown=function(e){if(e.code==='Space'){e.preventDefault();firePedal();}};\n  }\n  function firePedal(){var b=document.getElementById('cb-pedal');if(currentPedal && (!b||!b.disabled))currentPedal();}\n\n  // The bench (the use-case) orchestrates two GENERIC capabilities — it never\n  // calls a bench-specific action. First ask core-scan:identify \"what is this?\"\n  // (best-effort, from the measurements + observations); then inventory:create-\n  // item to add the tool, using the AI's name/brand when it's confident, else\n  // the deterministic spec we composed. Generic modules, app-side wiring.\n  function commit(){\n    var p=document.getElementById('cb-pedal'); if(p){p.disabled=true;p.textContent='Committing…';}\n    var c=item.captured, floor=specName(c), bin=item.bin;\n    var fields={}; Object.keys(c).forEach(function(k){if(k[0]!=='_')fields[k]=c[k];});\n    fields.bin=bin;\n    var measurements={diameter_mm:c.diameter_mm,shank_dia_mm:c.shank_dia_mm,overall_length_mm:c.overall_length_mm,flute_length_mm:c.flute_length_mm,weight_g:c.weight_g};\n    var observations={tool_type:c.tool_type,flute_count:c.flute_count,end_type:c.end_type,material:c.material};\n    var doIdentify = SDK.invoke\n      ? SDK.invoke('core-scan:identify',{args:{measurements:measurements,observations:observations}}).then(function(r){return (r&&r.result)||r||{};}).catch(function(){return {};})\n      : Promise.resolve({});\n    doIdentify.then(function(id){\n      var ai = !!(id && id.identified && id.name);\n      var name = ai ? id.name : floor;\n      var mfr = (id && id.brand) ? id.brand : undefined;\n      return SDK.invoke('inventory:create-item',{args:{instance:'tooling',name:name,manufacturer:mfr,fields:fields}})\n        .then(function(cr){var res=(cr&&cr.result)||cr||{}; addLog(res.name||name,bin,ai); showResult(res.name||name,bin,ai);});\n    }).catch(function(){addLog(floor,bin,false);showResult(floor,bin,false);});\n  }\n\n  function showResult(name,bin,ai){\n    item=null; tape();\n    stage.innerHTML='<div class=\"cb-step\">// committed</div>'+\n      '<div class=\"cb-result\">✅ <div><div class=\"nm\">'+name+(ai?' <span class=\"cb-ai\">AI ✓</span>':'')+'</div><div class=\"cb-sub\">filed in '+bin+'</div></div></div>'+\n      '<div class=\"cb-row\"><div class=\"cb-spacer\"></div>'+pedal('Next tool')+'</div>';\n    bind(start);\n  }\n\n  function addLog(name,bin,ai){\n    if(logEl.querySelector('.cb-empty'))logEl.innerHTML='';\n    logEl.insertBefore(el('<div class=\"cb-logrow\">🔧 <span>'+name+'</span>'+(ai?' <span class=\"cb-ai\">AI ✓</span>':'')+'<span class=\"loc\">'+bin+'</span></div>'),logEl.firstChild);\n  }\n\n  // ── poll the live edge state (the agent writes this app's \"bench-live\" KV) ──\n  function pollLive(){\n    if(!SDK.appLoad){return;}\n    SDK.appLoad('bench-live').then(function(v){\n      var now=Date.now();\n      if(v && typeof v==='object' && typeof v.ts==='number' && (now - v.ts) < 6000){\n        if(!live.on){live.on=true;dotEl.classList.add('on');connTxt.textContent='Bench connected — live readings from the edge agent.';if(item)render();}\n        live.caliper_mm=v.caliper_mm; live.scale_g=v.scale_g;\n        // refresh the live readout in place (no full re-render → no flicker)\n        var lv=document.getElementById('cb-livev');\n        if(lv && item){var st=item.steps[item.i]; if(st&&st.chan&&live[st.chan]!=null)lv.textContent=fmt(live[st.chan]);}\n        // a physical pedal press = pedal_seq ticking up\n        if(typeof v.pedal_seq==='number' && v.pedal_seq>live.pedal_seq){live.pedal_seq=v.pedal_seq; firePedal();}\n      } else if(live.on){\n        live.on=false;dotEl.classList.remove('on');connTxt.textContent='Bench not connected — simulated readings (Phase 1).';if(item)render();\n      }\n    }).catch(function(){});\n  }\n  setInterval(pollLive, 400); pollLive();\n\n  render();\n})();\n</script>",
                "height": 720
              }
            ]
          }
        ]
      }
    ]
  }
