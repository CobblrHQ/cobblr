{
  "manifest": {
    "id": "cobblr.flagship.vehicles",
    "name": "Vehicles",
    "version": "0.4.9",
    "description": "Your vehicles as their own table - make/model/year, VIN, mileage, plate - with service logs (oil, tires, brakes) and next-due dates on your calendar. Replaces a glovebox folder of receipts and a sticky note on the windshield.",
    "author": "Cobblr",
    "released_at": "2026-07-13",
    "changelog": "Mileage counts as the vehicle's use, so a bill of sale's odometer reading fills it when it is empty, and a service schedule can fall due every so many miles. Earlier changes below.: The licence plate is a vehicle's identity, like its VIN: two scans with different plates are never taken for one car, and a typed plate finds the car you already have. Earlier changes below.: Renamed to Vehicles and given its OWN table (an assets instance), not generic Assets with extra columns - its own nav entry, a “New vehicle” button, and only the fields a vehicle needs (VIN, make, model, year, trim, mileage, fuel, color). Service logs come from core-maintenance; scan a VIN and it fills the whole record.",
    "releases": [
      {
        "version": "0.4.9",
        "released_at": "2026-10-07",
        "notes": "A group's summary adds up only what adds up: a length or a weight per item is totalled as length or weight times how many you have, and a year, a size or a temperature is no longer summed."
      },
      {
        "version": "0.4.8",
        "released_at": "2026-10-05",
        "notes": "Track registration and inspection expiry dates, renew without losing time, and choose when reminders arrive."
      },
      {
        "version": "0.4.5",
        "released_at": "2026-10-02",
        "notes": "A vehicle fills its empty Model, Year and Trim from its VIN and its name (\"Yamaha YZF-R3, Blue\" says the model), never over what you typed, with an Undo. Bought from is who sold it, so the place you found it and the person you bought it from are kept as two things."
      },
      {
        "version": "0.4.4",
        "released_at": "2026-10-02",
        "notes": "A dropdown says whether a value you type is remembered as a choice for next time; the open ones (a brand, a vendor, a material) offer what you typed before. Setting a service schedule offers the usual jobs (oil change, tire rotation, brake pads and more) beside the ones you have logged."
      },
      {
        "version": "0.4.3",
        "released_at": "2026-10-02",
        "notes": "Mileage counts as the vehicle's use, so a bill of sale's odometer reading fills it when it is empty, and a service schedule can fall due every so many miles."
      }
    ],
    "requires": [
      {
        "module": "assets"
      },
      {
        "module": "core-maintenance"
      }
    ],
    "provides_instances": [
      {
        "module": "assets",
        "instance_name": "vehicles",
        "service_tasks": [
          "Oil change",
          "Oil filter",
          "Air filter",
          "Cabin air filter",
          "Tire rotation",
          "Tire pressure check",
          "Brake pads",
          "Brake fluid",
          "Coolant flush",
          "Spark plugs",
          "Transmission fluid",
          "Chain clean and lube",
          "Battery check",
          "Wiper blades",
          "Inspection / registration"
        ],
        "display_name": "Vehicles",
        "wires": [
          {
            "source_kind": "vehicles:item",
            "action_id": "core-scan:fill-known",
            "says": "A new vehicle fills its empty Model, Year and Trim from its VIN and its name.",
            "trigger_type": "event",
            "trigger_event": "assets.asset.created"
          },
          {
            "source_kind": "vehicles:item",
            "action_id": "core-scan:fill-known",
            "says": "Entering a VIN fills the vehicle's empty Model, Year and Trim from it.",
            "trigger_type": "event",
            "trigger_event": "assets.asset.updated"
          }
        ],
        "glyph": "🚗",
        "item_noun": "vehicle",
        "scan_keywords": [
          "vin",
          "vehicle",
          "car",
          "truck",
          "suv",
          "van",
          "minivan",
          "sedan",
          "coupe",
          "hatchback",
          "motorcycle",
          "automobile",
          "odometer",
          "mileage",
          "license plate",
          "make",
          "model",
          "engine"
        ],
        "field_defs": [
          {
            "entity_kind": "assets:asset",
            "name": "year",
            "display_label": "Year",
            "type": "number",
            "aggregate": "none",
            "position": 1,
            "decode_role": "decode:year"
          },
          {
            "entity_kind": "assets:asset",
            "name": "trim",
            "display_label": "Trim",
            "type": "text",
            "position": 2,
            "help": "The trim level - e.g. EX, Sport, Limited. Filled from a VIN decode when available.",
            "decode_role": "decode:trim"
          },
          {
            "entity_kind": "assets:asset",
            "name": "license_plate",
            "display_label": "License plate",
            "type": "text",
            "position": 3,
            "field_role": "identifier"
          },
          {
            "entity_kind": "assets:asset",
            "name": "mileage",
            "display_label": "Mileage",
            "type": "number",
            "aggregate": "none",
            "position": 4,
            "help": "Current odometer reading - service schedules count from this.",
            "field_role": "usage"
          },
          {
            "entity_kind": "assets:asset",
            "name": "fuel_type",
            "display_label": "Fuel",
            "type": "text",
            "position": 5,
            "learns": false,
            "choices": [
              "Gas",
              "Diesel",
              "Hybrid",
              "Electric"
            ],
            "decode_role": "decode:fuel_type"
          },
          {
            "entity_kind": "assets:asset",
            "name": "color",
            "display_label": "Color",
            "type": "text",
            "position": 6
          },
          {
            "entity_kind": "assets:asset",
            "name": "registration_expires",
            "display_label": "Registration expires",
            "type": "date",
            "position": 7
          },
          {
            "entity_kind": "assets:asset",
            "name": "registration_number",
            "display_label": "Registration number",
            "type": "text",
            "field_role": "identifier",
            "position": 8
          },
          {
            "entity_kind": "assets:asset",
            "name": "registration_state",
            "display_label": "Registration region",
            "type": "text",
            "position": 9
          },
          {
            "entity_kind": "assets:asset",
            "name": "inspection_expires",
            "display_label": "Inspection expires",
            "type": "date",
            "position": 10
          },
          {
            "entity_kind": "assets:asset",
            "name": "inspection_station",
            "display_label": "Inspection station",
            "type": "text",
            "position": 11
          }
        ],
        "field_overrides": [
          {
            "entity_kind": "assets:asset",
            "name": "manufacturer",
            "display_label": "Make",
            "decode_role": "decode:make"
          },
          {
            "entity_kind": "assets:asset",
            "name": "model",
            "display_label": "Model",
            "decode_role": "decode:model"
          },
          {
            "entity_kind": "assets:asset",
            "name": "serial_number",
            "display_label": "VIN",
            "decode_role": "identifier:vin"
          },
          {
            "entity_kind": "assets:asset",
            "name": "vendor",
            "field_role": "seller"
          },
          {
            "entity_kind": "assets:asset",
            "name": "short_name",
            "hidden": true
          },
          {
            "entity_kind": "assets:asset",
            "name": "type",
            "hidden": true
          },
          {
            "entity_kind": "assets:asset",
            "name": "quantity",
            "hidden": true
          },
          {
            "entity_kind": "assets:asset",
            "name": "excitement",
            "hidden": true
          },
          {
            "entity_kind": "assets:asset",
            "name": "last_service_at",
            "hidden": true
          }
        ],
        "saved_views": [
          {
            "entity_kind": "assets:asset",
            "name": "By make",
            "view_type": "table",
            "pinned": true,
            "config": {
              "group_by": "manufacturer",
              "visible_fields": [
                "title",
                "year",
                "model",
                "mileage",
                "fuel_type"
              ]
            }
          }
        ]
      }
    ],
    "features": [
      {
        "key": "connected-car",
        "name": "Connected car (auto-mileage)",
        "question": "Does a device report your mileage?",
        "description": "Let the car update its own odometer. Point anything that can POST JSON - an OBD reader via a phone app, a WiFi OBD device through Home Assistant, or a telematics service webhook - at a Cobblr inbound webhook (Configuration → Integrations → Inbound tokens) with a body like {\"vehicle\": \"Honda Civic\", \"odometer\": 48650}. The shipped wire matches the vehicle by name and writes the mileage; service schedules and the calendar react to the new reading. Add more keys to the payload and the wire to sync other fields (fuel level, battery health, …).",
        "default": false,
        "wires": [
          {
            "source_kind": "assets:asset",
            "action_id": "assets:update-fields",
            "trigger_type": "event",
            "trigger_event": "core-integrations.inbound.received",
            "target": "none",
            "args": {
              "asset": "{{event.body.vehicle}}",
              "mileage": "{{event.body.odometer}}"
            }
          }
        ]
      }
    ]
  }
}
