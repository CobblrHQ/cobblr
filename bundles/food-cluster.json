{
  "manifest": {
    "id": "cobblr.flagship.food-cluster",
    "name": "Kitchen & Groceries",
    "version": "0.1.0",
    "description": "Turn inventory + lists into a kitchen system: track what's in the fridge/pantry with expiry + storage, and auto-build a shopping list when something runs low. Replaces a fridge-inventory app + a separate shopping-list app — extendable.",
    "author": "Cobblr",
    "requires": [
      { "module": "inventory" },
      { "module": "lists" }
    ],
    "field_defs": [
      { "entity_kind": "inventory:part", "name": "expires_on", "display_label": "Expires", "type": "date", "position": 1 },
      { "entity_kind": "inventory:part", "name": "opened_on", "display_label": "Opened", "type": "date", "position": 2 },
      { "entity_kind": "inventory:part", "name": "storage", "display_label": "Storage", "type": "text", "position": 3, "choices": ["Fridge", "Freezer", "Pantry", "Counter", "Spice rack"] },
      { "entity_kind": "inventory:part", "name": "food_category", "display_label": "Category", "type": "text", "position": 4, "choices": ["Produce", "Dairy", "Meat", "Bakery", "Frozen", "Canned", "Dry goods", "Condiments", "Beverages", "Snacks"] }
    ],
    "wires": [
      {
        "source_kind": "inventory:part",
        "action_id": "lists:add-item",
        "trigger_type": "event",
        "trigger_event": "inventory.stock.low",
        "args": { "listTitle": "Shopping list" }
      },
      {
        "source_kind": "inventory:part",
        "action_id": "lists:add-item",
        "trigger_type": "event",
        "trigger_event": "lists.item.expiring",
        "args": { "listTitle": "Shopping list" }
      },
      {
        "source_kind": "inventory:part",
        "action_id": "inventory:adjust-stock",
        "trigger_type": "event",
        "trigger_event": "lists.item.checked",
        "args": { "delta": 1, "reason": "Restocked — checked off the shopping list" }
      }
    ]
  },
  "confirm": true
}
