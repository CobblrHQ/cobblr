  "manifest": {
    "id": "cobblr.flagship.groceries",
    "version": "0.14.0",
    "releases": [
      {
        "version": "0.13.8",
        "released_at": "2026-10-17",
        "notes": "A food scanned from Open Food Facts keeps the allergens and traces the catalog lists, shown as warning pills on the scan and on the pantry item, and a view can filter on a word in them."
      },
      {
        "version": "0.14.0",
        "released_at": "2026-10-17",
        "notes": "Food moved into the fridge or the freezer is re-dated by its cold shelf life, and by its warm one when it comes out; the record's history says why. Each item can state a fridge and a freezer number beside the existing two."
      },
      {
        "version": "0.13.7",
        "released_at": "2026-10-07",
        "notes": "A group's summary adds up only what adds up: a length or a weight per item is totalled as length or weight times how many you have, and a year, a size or a temperature is no longer summed."
      },
      {
        "version": "0.13.5",
        "released_at": "2026-10-03",
        "notes": "A scanned bottle of water now goes to Groceries: the barcode catalog calls it water, and Groceries now knows the word."
      },
      {
        "version": "0.13.1",
        "released_at": "2026-10-02",
        "notes": "A dropdown says whether a value you type is remembered as a choice for next time; the open ones (a brand, a vendor, a material) offer what you typed before."
      }
    ],
