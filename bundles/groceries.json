        "field_defs": [
          {
            "entity_kind": "groceries:item",
            "name": "shelf_life_days",
            "display_label": "Good for (days)",
            "type": "number",
            "aggregate": "none",
            "position": 1,
            "help": "How long this keeps from the day it arrives. Used to date a new one when you add it, so you never type a use-by. Leave blank and nothing is dated for you."
          },
          {
            "entity_kind": "groceries:item",
            "name": "shelf_life_opened_days",
            "display_label": "Once opened, good for (days)",
            "type": "number",
            "aggregate": "none",
            "position": 2,
            "help": "A lemon lasts weeks whole and days once cut. Opening one starts this shorter clock on that one only; the unopened ones keep their own dates."
          },
          {
            "entity_kind": "groceries:item",
            "name": "shelf_life_refrigerated_days",
            "display_label": "In the fridge, good for (days)",
            "type": "number",
            "aggregate": "none",
            "position": 2,
            "help": "How long this keeps unopened in the fridge. Moving it into the fridge dates its lot by this, and moving it out puts the warm clock back. Leave blank and a move changes nothing."
          },
          {
            "entity_kind": "groceries:item",
            "name": "shelf_life_frozen_days",
            "display_label": "In the freezer, good for (days)",
            "type": "number",
            "aggregate": "none",
            "position": 2,
            "help": "How long this keeps unopened in the freezer. Moving it into the freezer dates its lot by this; with none given the fridge number is used. Leave both blank and a move changes nothing."
          },
          {
            "entity_kind": "groceries:item",
            "name": "grace_days",
            "display_label": "Still fine for (days past)",
            "type": "number",
            "aggregate": "none",
            "position": 3,
            "help": "Food does not go off at midnight. Inside this window past the use-by it is mentioned rather than alarming; beyond it you are asked whether you threw it out."
          },
          {
            "entity_kind": "groceries:item",
            "name": "storage_requirement",
            "display_label": "Must be kept",
            "type": "text",
            "position": 0,
            "learns": false,
            "choices": [
              "frozen",
              "refrigerated",
              "ambient"
            ],
            "help": "How this has to be kept, which is not the same as where it currently is. Filled in from what the {{noun}} is when you scan it, and left blank when that is not clear enough to say. Anything you choose here is used instead."
          },
          {
            "entity_kind": "groceries:item",
            "name": "expires_on",
            "display_label": "Expires",
            "type": "date",
            "position": 1,
            "field_role": "expiry"
          },
          {
            "entity_kind": "groceries:item",
            "name": "acquired_on",
            "display_label": "Bought on",
            "type": "date",
            "position": 2,
            "field_role": "acquired-on"
          },
          {
            "entity_kind": "groceries:item",
            "name": "opened_on",
            "display_label": "Opened",
            "type": "date",
            "position": 2
          },
          {
            "entity_kind": "groceries:item",
            "name": "food_category",
            "display_label": "Category",
            "type": "text",
            "position": 4,
            "learns": true,
            "choices": [
              "Produce",
              "Dairy",
              "Meat",
              "Bakery",
              "Frozen",
              "Canned",
              "Dry goods",
              "Condiments",
              "Beverages",
              "Snacks"
            ]
          },
          {
            "entity_kind": "groceries:item",
            "name": "allergens",
            "display_label": "Contains",
            "type": "text",
            "position": 5,
            "learns": false,
            "help": "What the food says it contains, as the catalog lists it (milk, nuts, soybeans). Filled in from Open Food Facts when you scan it, and left blank when the catalog lists none. Blank means not listed, not that there are none."
          },
          {
            "entity_kind": "groceries:item",
            "name": "traces",
            "display_label": "May contain",
            "type": "text",
            "position": 6,
            "learns": false,
            "help": "What the food may carry traces of, as the catalog lists it. Filled in from Open Food Facts when you scan it. Blank means not listed."
          }
        ],
