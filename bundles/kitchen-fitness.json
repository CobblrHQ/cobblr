{
  "manifest": {
    "id": "cobblr.flagship.kitchen-fitness",
    "catalog": "disabled",
    "version": "0.1.1",
    "name": "Kitchen × Fitness — grocery spend",
    "description": "Connects the grocery flow to the Tracking module: order received → log spend into a metric. Neither module knows about the other.",
    "author": "Cobblr",
    "requires": [
      {
        "module": "purchases"
      },
      {
        "module": "tracking"
      }
    ],
    "wires": [
      {
        "source_kind": "purchases:order_item",
        "action_id": "tracking:log-measurement",
        "trigger_type": "event",
        "trigger_event": "purchases.order_item.received",
        "args": {
          "metricName": "Grocery spend",
          "unit": "$",
          "goalDirection": "down",
          "valueKey": "lineCost",
          "note": "auto-logged on order arrival"
        }
      }
    ]
  }
}
