{
  "manifest": {
    "id": "cobblr.flagship.yarn",
    "version": "0.9.5",
    "name": "Yarn",
    "description": "Yarn as its own inventory instance: counted in balls, skeins or hanks, yarn-only fields, grouped by weight. Optional Hooks, Supplies and Patterns tables.",
    "author": "Cobblr",
    "released_at": "2026-09-29",
    "changelog": "Importing patterns with Source: Ribblr now shows how to get them out of Ribblr: what can be downloaded, what cannot, and how to bring the downloads in.",
    "releases": [
      {
        "version": "0.9.5",
        "released_at": "2026-10-07",
        "notes": "By weight adds up only what adds up: length per ball is totalled as length times balls (Total length), and each row's count says it in your own word, 2 balls or 3 hanks."
      },
      {
        "version": "0.9.3",
        "released_at": "2026-10-02",
        "notes": "A dropdown says whether a value you type is remembered as a choice for next time; the open ones (a brand, a vendor, a material) offer what you typed before."
      },
      {
        "version": "0.9.2",
        "released_at": "2026-09-29",
        "notes": "Importing patterns with Source: Ribblr now shows how to get them out of Ribblr: what can be downloaded, what cannot, and how to bring the downloads in."
      },
      {
        "version": "0.9.0",
        "released_at": "2026-07-15",
        "notes": "Notions is now Supplies: the table for stitch markers, yarn needles, safety eyes, stuffing and buttons says what goes in it under its name, and you can still call it Notions (pick the word in its Settings); searching for notions finds it, and a pattern's notions are still checked against it. Your Notions table is renamed on this update, and everything in it stays. Earlier: a Notions table for stitch markers, yarn needles, safety eyes and stuffing; a pattern's notions are checked against it. Earlier: Import from Ravelry on the Yarn table brings your Ravelry stash in, and your projects into Patterns: connect once, then press it again any time to update. Earlier: A pattern now knows what it needs: its yarns and hooks are read from the PDF, matched against your stash, and what is missing goes on your shopping list in one tap. Finishing a pattern takes each yarn off its own balls. Earlier: The scanner fills Dye lot from the lot printed on a label, and a dye lot is never shared as a fact about the yarn. Earlier: Call your yarn what you call it: ball, skein or hank. Pick the word when you add Yarn, or change it in the Yarn table's settings, and every label, your yarn's counts and Cobb all say it. Earlier: Designs are now Patterns: a pattern keeps its PDF, photos and notes, its designer, where it came from and how hard it is, and the yarn it needs. Import patterns takes a pile of PDFs or a zipped folder: each PDF becomes a pattern with its file, a zip's folders fill in the category, and a PDF you already have is never added twice. Your Designs table is renamed on this update, and everything in it stays."
      }
    ],
    "requires": [
      {
        "module": "inventory"
      }
    ],
    "provides_instances": [
      {
        "module": "inventory",
        "instance_name": "yarn",
        "faces": {
          "stock": true
        },
        "connector_import": {
          "connector": "ravelry",
          "label": "Import from Ravelry",
          "sections": {
            "stash": "yarn",
            "projects": "designs"
          }
        },
        "display_name": "Yarn",
        "glyph": "🧶",
        "item_noun": "yarn",
        "qty_unit": "ball",
        "noun": {
          "of": "unit",
          "singular": "ball",
          "plural": "balls",
          "alternatives": [
            {
              "singular": "skein",
              "plural": "skeins"
            },
            {
              "singular": "hank",
              "plural": "hanks"
            }
          ]
        },
        "field_defs": [
          {
            "entity_kind": "inventory:part",
            "name": "color",
            "display_label": "Color",
            "type": "text",
            "position": 1,
            "renderer": "color-hex",
            "help": "The basic shade. Pick a hex/colour for the swatch."
          },
          {
            "entity_kind": "inventory:part",
            "name": "colorway",
            "display_label": "Colorway",
            "type": "text",
            "position": 2,
            "help": "The maker's named shade, e.g. “Peacock Heather” (printed on the yarn label)."
          },
          {
            "entity_kind": "inventory:part",
            "name": "fiber",
            "display_label": "Fibre",
            "type": "text",
            "position": 3,
            "learns": true,
            "choices": [
              "Wool",
              "Merino",
              "Cotton",
              "Acrylic",
              "Nylon",
              "Chenille",
              "Alpaca",
              "Silk",
              "Linen",
              "Bamboo",
              "Cashmere",
              "Blend"
            ],
            "help": "What the yarn is made of."
          },
          {
            "entity_kind": "inventory:part",
            "name": "weight_class",
            "display_label": "Weight",
            "type": "text",
            "position": 4,
            "learns": false,
            "choices": [
              "0 – Lace",
              "1 – Fingering",
              "2 – Sport",
              "3 – DK",
              "4 – Worsted",
              "4 – Aran",
              "5 – Bulky",
              "6 – Super Bulky"
            ],
            "help": "Craft Yarn Council standard weight. 0 (Lace, thinnest) to 6 (Super Bulky, thickest)."
          },
          {
            "entity_kind": "inventory:part",
            "name": "vendor",
            "display_label": "Vendor",
            "type": "text",
            "position": 5,
            "learns": true,
            "choices": [
              "Michaels",
              "Hobby Lobby",
              "Walmart",
              "Joann",
              "Amazon",
              "Etsy",
              "Local yarn shop"
            ],
            "help": "Where you bought it."
          },
          {
            "entity_kind": "inventory:part",
            "name": "length_per_skein",
            "display_label": "Length / {{noun}} (m)",
            "type": "number",
            "aggregate": "per_unit",
            "unit": "m",
            "position": 6,
            "help": "Metres per {{noun}}, from the label, used to estimate if you have enough for a project."
          },
          {
            "entity_kind": "inventory:part",
            "name": "capacity",
            "display_label": "Full {{noun}}",
            "type": "computed",
            "template": "{{ length_per_skein }}",
            "position": 7,
            "help": "Metres in one full {{noun}}, from the length above. When you track {{noun}} by {{noun}}, each opened {{noun}}'s gauge is measured against this: you never type it."
          },
          {
            "entity_kind": "inventory:part",
            "name": "dye_lot",
            "display_label": "Dye lot",
            "type": "text",
            "position": 8,
            "field_role": "lot",
            "help": "The batch code on the label, buy the same lot so colours match across {{nouns}}."
          },
          {
            "entity_kind": "inventory:part",
            "name": "needle_size",
            "display_label": "Suggested needle size",
            "type": "text",
            "position": 9,
            "learns": false,
            "choices": [
              "2.0 mm",
              "2.5 mm",
              "3.0 mm",
              "3.5 mm",
              "4.0 mm",
              "4.5 mm",
              "5.0 mm",
              "5.5 mm",
              "6.0 mm",
              "6.5 mm",
              "7.0 mm",
              "8.0 mm",
              "9.0 mm",
              "10.0 mm",
              "12.0 mm"
            ],
            "help": "The needle/hook size the label recommends for this yarn (in mm)."
          }
        ],
        "field_overrides": [
          {
            "entity_kind": "inventory:part",
            "name": "manufacturer",
            "display_label": "Brand"
          },
          {
            "entity_kind": "inventory:part",
            "name": "cost",
            "display_label": "Price / {{noun}}"
          },
          {
            "entity_kind": "inventory:part",
            "name": "category",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "location",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "warranty",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "min_qty",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "supplier_url",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "serial_number",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "model_number",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "maintenance",
            "hidden": true
          },
          {
            "entity_kind": "inventory:part",
            "name": "consumable"
          }
        ],
        "saved_views": [
          {
            "entity_kind": "inventory:part",
            "name": "By weight",
            "view_type": "table",
            "pinned": true,
            "config": {
              "group_by": "weight_class",
              "visible_fields": [
                "title",
                "color",
                "colorway",
                "fiber",
                "vendor",
                "qty",
                "length_per_skein"
              ]
            }
          }
        ]
      }
    ],
    "features": [
      {
        "key": "designs",
        "name": "Patterns",
        "question": "Want to keep your patterns here too?",
        "description": "A 'Patterns' table (a projects instance): each pattern with its PDF, photos and notes, its category, designer and source, and the yarn and hooks it needs, read from the PDF and matched against your stash; finishing it takes each yarn off its own balls. Import a pile of PDFs or a zipped folder in one go.",
        "default": false,
        "requires": [
          {
            "module": "projects"
          }
        ],
        "next_steps": [
          {
            "label": "Open your Patterns",
            "module": "projects",
            "path": "/instances/designs",
            "hint": "Import your pattern PDFs; each becomes a pattern with its file."
          }
        ],
        "provides_instances": [
          {
            "module": "projects",
            "instance_name": "designs",
            "display_name": "Patterns",
            "glyph": "🧵",
            "item_noun": "pattern",
            "file_intake": {
              "accept": [
                "application/pdf"
              ],
              "role": "pattern",
              "folder": "Patterns",
              "folder_field": "pattern_category",
              "ask": [
                "pattern_source"
              ],
              "label": "Import patterns",
              "guides": [
                {
                  "when": {
                    "field": "pattern_source",
                    "equals": "Ribblr"
                  },
                  "title": "Getting your patterns out of Ribblr",
                  "steps": [
                    "On Ribblr, open your library and download every pattern that shows a download icon: the designer attached a PDF.",
                    "Download the PDFs you uploaded yourself too. They lock when a Ribblr+ membership lapses, and a month of Ribblr+ opens them again.",
                    "A Ribblr ePattern cannot be downloaded. Ask its designer for a PDF, which is Ribblr's own advice, or email Ribblr support for a copy of your data.",
                    "Zip your downloads folder, or pick the PDFs, and import them here. Each PDF becomes a pattern with its file."
                  ]
                }
              ]
            },
            "field_defs": [
              {
                "entity_kind": "projects:project",
                "name": "pattern_url",
                "display_label": "Pattern link",
                "type": "url",
                "position": 1,
                "renderer": "url-link",
                "help": "Where the pattern lives online, if it does (Ravelry, a shop, a blog post). A PDF you import is kept on the pattern itself."
              },
              {
                "entity_kind": "projects:project",
                "name": "pattern_category",
                "display_label": "Category",
                "type": "text",
                "position": 2,
                "learns": true,
                "choices": [
                  "Wearables",
                  "Toys",
                  "Home-wear",
                  "Blankets"
                ],
                "help": "What kind of make this is. Importing a zip, a top folder named like a category fills it in."
              },
              {
                "entity_kind": "projects:project",
                "name": "designer",
                "display_label": "Designer",
                "type": "text",
                "position": 3,
                "help": "Who wrote the pattern."
              },
              {
                "entity_kind": "projects:project",
                "name": "pattern_source",
                "display_label": "Source",
                "type": "text",
                "position": 4,
                "learns": true,
                "choices": [
                  "Ribblr",
                  "Ravelry",
                  "Etsy",
                  "LoveCrafts",
                  "A book or magazine",
                  "Free online",
                  "My own"
                ],
                "help": "Where you got it. Asked once when you import a batch."
              },
              {
                "entity_kind": "projects:project",
                "name": "difficulty",
                "display_label": "Difficulty",
                "type": "text",
                "position": 5,
                "learns": false,
                "choices": [
                  "Beginner",
                  "Easy",
                  "Intermediate",
                  "Experienced"
                ],
                "help": "How hard the pattern says it is."
              }
            ],
            "saved_views": [
              {
                "entity_kind": "projects:project",
                "name": "By category",
                "view_type": "table",
                "pinned": true,
                "config": {
                  "group_by": "pattern_category",
                  "visible_fields": [
                    "title",
                    "pattern_category",
                    "designer",
                    "pattern_source",
                    "status"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "key": "hooks",
        "name": "Hooks & needles",
        "question": "Keep track of your hooks & needles?",
        "description": "A separate 'Hooks' table (an inventory instance): your crochet hooks / knitting needles by gauge + material.",
        "default": false,
        "next_steps": [
          {
            "label": "Open your Hooks table",
            "module": "inventory",
            "path": "/instances/hooks",
            "hint": "Crochet hooks / knitting needles by gauge + material."
          }
        ],
        "provides_instances": [
          {
            "module": "inventory",
            "instance_name": "hooks",
            "display_name": "Hooks",
            "glyph": "🪡",
            "item_noun": "hook",
            "qty_unit": "each",
            "field_defs": [
              {
                "entity_kind": "inventory:part",
                "name": "hook_gauge",
                "display_label": "Hook gauge",
                "type": "text",
                "position": 1,
                "learns": false,
                "choices": [
                  "1.0 mm",
                  "1.5 mm",
                  "2.0 mm",
                  "2.5 mm",
                  "3.0 mm",
                  "3.5 mm",
                  "4.0 mm",
                  "4.5 mm",
                  "5.0 mm",
                  "5.5 mm",
                  "6.0 mm",
                  "6.5 mm",
                  "7.0 mm",
                  "8.0 mm",
                  "9.0 mm",
                  "10.0 mm"
                ],
                "help": "Hook/needle size in mm (the number stamped on it)."
              },
              {
                "entity_kind": "inventory:part",
                "name": "hook_material",
                "display_label": "Hook material",
                "type": "text",
                "position": 2,
                "learns": true,
                "choices": [
                  "All-metal",
                  "Metal + silicone grip",
                  "Wood",
                  "Bamboo",
                  "Plastic"
                ],
                "help": "What the hook is made of, affects grip + glide."
              }
            ],
            "field_overrides": [
              {
                "entity_kind": "inventory:part",
                "name": "category",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "location",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "warranty",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "min_qty",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "supplier_url",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "serial_number",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "model_number",
                "hidden": true
              }
            ],
            "saved_views": [
              {
                "entity_kind": "inventory:part",
                "name": "By material",
                "view_type": "table",
                "pinned": true,
                "config": {
                  "group_by": "hook_material",
                  "visible_fields": [
                    "title",
                    "hook_gauge",
                    "hook_material",
                    "qty"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "key": "notions",
        "name": "Supplies",
        "question": "Keep track of your supplies (stitch markers, safety eyes, stuffing)?",
        "description": "A 'Supplies' table (or 'Notions', if that is your word): stitch markers, yarn needles, safety eyes, stuffing, buttons. A pattern's notions are checked against it, and what is missing goes on your shopping list in one tap.",
        "default": false,
        "next_steps": [
          {
            "label": "Open your Supplies",
            "module": "inventory",
            "path": "/instances/notions",
            "hint": "Markers, needles, eyes, stuffing: what each pattern asks for beside its yarn."
          }
        ],
        "provides_instances": [
          {
            "module": "inventory",
            "instance_name": "notions",
            "display_name": "{{Nouns}}",
            "glyph": "📍",
            "item_noun": "supply",
            "hint": "markers, needles, safety eyes, stuffing, buttons",
            "noun": {
              "of": "item",
              "singular": "supply",
              "plural": "supplies",
              "alternatives": [
                {
                  "singular": "notion",
                  "plural": "notions"
                }
              ]
            },
            "qty_unit": "each",
            "faces": {
              "stock": true
            },
            "field_defs": [
              {
                "entity_kind": "inventory:part",
                "name": "notion_type",
                "display_label": "Type",
                "type": "text",
                "position": 1,
                "learns": true,
                "choices": [
                  "Stitch markers",
                  "Stitch holders",
                  "Yarn needle",
                  "Cable needle",
                  "Safety eyes",
                  "Stuffing",
                  "Buttons",
                  "Row counter",
                  "Other"
                ],
                "help": "What it is. What a pattern asks for is matched to your {{nouns}} by this."
              },
              {
                "entity_kind": "inventory:part",
                "name": "notion_size",
                "display_label": "Size",
                "type": "text",
                "position": 2,
                "help": "For safety eyes and buttons: the size in mm (e.g. 8 mm)."
              }
            ],
            "field_overrides": [
              {
                "entity_kind": "inventory:part",
                "name": "category",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "warranty",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "supplier_url",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "serial_number",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "model_number",
                "hidden": true
              },
              {
                "entity_kind": "inventory:part",
                "name": "maintenance",
                "hidden": true
              }
            ],
            "saved_views": [
              {
                "entity_kind": "inventory:part",
                "name": "By type",
                "view_type": "table",
                "pinned": true,
                "config": {
                  "group_by": "notion_type",
                  "visible_fields": [
                    "title",
                    "notion_type",
                    "notion_size",
                    "qty"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "key": "shopping-list",
        "name": "Shopping list",
        "question": "Auto-build a shopping list when yarn runs low?",
        "description": "When yarn runs low it auto-lands on a 'Shopping list' so you know what to restock.",
        "default": false,
        "requires": [
          {
            "module": "lists"
          }
        ],
        "provides_instances": [
          {
            "module": "inventory",
            "instance_name": "yarn",
            "display_name": "Yarn",
            "wires": [
              {
                "source_kind": "inventory:part",
                "action_id": "lists:add-item",
                "trigger_type": "event",
                "trigger_event": "inventory.stock.low",
                "args": {
                  "listTitle": "Shopping list"
                }
              }
            ]
          }
        ]
      },
      {
        "key": "scan",
        "name": "Scan to add",
        "question": "Add yarn by scanning a barcode or receipt?",
        "description": "Snap a barcode, ball band, or receipt to stock yarn fast (and log the purchase).",
        "default": false,
        "requires": [
          {
            "module": "core-scan"
          },
          {
            "module": "purchases"
          }
        ]
      }
    ]
  }
}
