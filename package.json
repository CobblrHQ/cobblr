{
  "name": "cobblr",
  "version": "0.0.1",
  "private": true,
  "description": "Cobblr \u2014 modular workflow platform for niche workflows.",
  "workspaces": [
    "api",
    "web",
    "packages/*",
    "modules/*",
    "sandboxed-modules/hello-as",
    "sandboxed-modules/url-archive",
    "sandboxed-modules/bricklink-sandboxed"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run --if-present typecheck",
    "lint:isolation": "tsx scripts/lint-module-isolation.ts",
    "lint:manifests": "tsx scripts/lint-manifests.ts",
    "lint:dockerfile-modules": "tsx scripts/lint-dockerfile-modules.ts",
    "lint:versions": "tsx scripts/lint-versions.ts",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "lint:changelog": "tsx scripts/lint-changelog.ts",
    "lint:scan-keywords": "tsx scripts/lint-scan-keywords.ts",
    "lint:bundle-quality": "tsx scripts/lint-bundle-quality.ts",
    "lint:detector-registry": "pnpm --filter @cobblr/digifab gen:check",
    "lint:deprecated-fks": "tsx scripts/lint-deprecated-table-fks.ts",
    "lint:self-heal": "tsx scripts/lint-self-heal.ts",
    "lint:write-guards": "tsx scripts/lint-module-write-guards.ts",
    "lint:config-routes": "tsx scripts/lint-config-routes.ts",
    "lint:authed-media": "tsx scripts/lint-authed-media.ts",
    "lint:action-predicates": "tsx scripts/lint-action-predicates.ts",
    "lint:pagination": "tsx scripts/lint-pagination.ts",
    "lint:inline-overrides": "tsx scripts/lint-inline-style-overrides.ts",
    "lint:unit-conversion": "tsx scripts/lint-unit-conversion.ts",
    "lint:component-kinds": "tsx scripts/lint-generic-component-kinds.ts",
    "build": "pnpm -r run --if-present build",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "pnpm -r run --if-present test",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true",
    "typecheck:fast": "pnpm -r run --if-present typecheck:fast",
    "embed:bridge": "node scripts/embed-bridge-bundle.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "marked": "^14.1.4"
  },
  "packageManager": "pnpm@11.8.0"
}
