{
  "name": "cobblr",
  "version": "0.0.1",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Cobblr \u2014 modular workflow platform for niche workflows.",
  "workspaces": [
    "api",
    "web",
    "packages/*",
    "modules/*",
    "sandboxed-modules/hello-as",
    "sandboxed-modules/url-archive",
    "sandboxed-modules/bricklink-sandboxed"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-sort --workspace-concurrency=${COBBLR_TSC_CONCURRENCY:-8} run --if-present typecheck && node scripts/verify-cache.mjs stamp typecheck",
    "verify:served": "node scripts/verify-served.mjs",
    "where": "tsx scripts/placement.ts",
    "lint": "node scripts/run-lints.mjs --one",
    "lint:all": "node scripts/run-lints.mjs",
    "eval:image-rank": "tsx e2e/image-rank-eval.mjs",
    "merged-prs-on-main": "bash scripts/merged-prs-on-main.sh",
    "audit:push-mirrors": "node scripts/audit-push-mirrors.mjs",
    "gen:app-surface": "tsx scripts/gen-app-surface.ts",
    "build": "pnpm -r run --if-present build",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "pnpm -r run --if-present test",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true; git config merge.semver-version.driver 'node scripts/merge-semver-version.mjs %O %A %B' 2>/dev/null || true",
    "typecheck:fast": "pnpm -r run --if-present typecheck:fast",
    "embed:bridge": "node scripts/embed-bridge-bundle.mjs",
    "pretest:unit": "node scripts/ensure-packages-built.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "e2e:scan-header": "node e2e/scan-header-margin.mjs",
    "e2e:tour-copy": "node e2e/tour-copy-names-what-is-on-screen.mjs",
    "e2e:approval-flow": "node e2e/approval-flow.mjs",
    "e2e:design-reserves-any-yarn": "node e2e/design-reserves-any-yarn.mjs",
    "e2e:two-cubepros-one-label": "node e2e/two-cubepros-one-label.mjs",
    "e2e:live-sort": "node e2e/live-sort-mobile.mjs",
    "e2e:try-captcha-recovery": "node --experimental-strip-types e2e/try-start-captcha-recovery.mjs",
    "e2e:sandbox-strip-foot": "node e2e/sandbox-strip-foot.mjs",
    "e2e:sandbox-ended": "node e2e/sandbox-ended.mjs",
    "e2e:csp-enforced": "node e2e/csp-enforced.mjs",
    "e2e:scan-menu": "node e2e/scan-menu-fit.mjs",
    "e2e:scan-mobile": "node e2e/scan-mobile-intake.mjs",
    "e2e:scan-card": "node e2e/scan-card-photo-column.mjs",
    "testbench:shipments": "tsx scripts/shipment-testbench.ts",
    "census:coupling": "tsx scripts/census-module-coupling.ts",
    "kiosk:check-recording": "node scripts/check-recording-static.mjs"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsdom": "^30.0.1",
    "marked": "^14.1.4",
    "playwright": "^1.60.0"
  },
  "packageManager": "pnpm@11.8.0"
}
