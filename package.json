{
  "name": "cobblr",
  "version": "0.0.1",
  "private": true,
  "description": "Cobblr \u2014 modular workflow platform for niche workflows.",
  "workspaces": [
    "api",
    "web",
    "packages/*",
    "modules/*",
    "sandboxed-modules/hello-as",
    "sandboxed-modules/url-archive",
    "sandboxed-modules/bricklink-sandboxed"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run --if-present typecheck",
    "lint:isolation": "tsx scripts/lint-module-isolation.ts",
    "lint:manifests": "tsx scripts/lint-manifests.ts",
    "lint:panel-registry": "tsx scripts/lint-panel-registry.ts",
    "lint:dockerfile-modules": "tsx scripts/lint-dockerfile-modules.ts",
    "lint:qr-token-parser": "tsx scripts/lint-qr-token-parser.ts",
    "lint:edge-url-predicate": "tsx scripts/lint-edge-url-predicate.ts",
    "lint:live-icons": "tsx scripts/lint-live-icons.ts",
    "lint:detail-path": "tsx scripts/lint-detail-path-substitution.ts",
    "lint:field-role-enum": "tsx scripts/lint-field-role-enum.ts",
    "lint:node-resolves": "tsx scripts/lint-node-resolves.ts",
    "lint:ci-paths-mirror": "tsx scripts/lint-ci-paths-mirror.ts",
    "lint:deploy-poke-nonfatal": "tsx scripts/lint-deploy-poke-nonfatal.ts",
    "lint:part-filter-cols": "tsx scripts/lint-part-filter-cols.ts",
    "lint:pdf-bench": "tsx modules/labels/tests/pdf-benchmark.mjs check",
    "lint:workspace-deps": "tsx scripts/lint-workspace-deps-declared.ts",
    "lint:ble-chooser": "tsx scripts/lint-ble-chooser-filter.ts",
    "lint:print-driver-options": "tsx scripts/lint-print-driver-options.ts",
    "lint:selfhost-mounts": "tsx scripts/lint-selfhost-mounts.ts",
    "lint:mcp-readme": "tsx scripts/lint-mcp-readme.ts",
    "lint:instance-resolvers": "tsx scripts/lint-instance-resolvers.ts",
    "lint:image-search": "tsx scripts/lint-image-search-single-surface.ts",
    "lint:instance-kinds": "tsx scripts/lint-instance-kind-registry.ts",
    "lint:workspace-types": "tsx scripts/lint-workspace-types-entry.ts",
    "eval:image-rank": "tsx e2e/image-rank-eval.mjs",
    "lint:versions": "tsx scripts/lint-versions.ts",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "lint:branch-live": "node scripts/lint-branch-live.mjs",
    "lint:changelog": "tsx scripts/lint-changelog.ts",
    "lint:scan-keywords": "tsx scripts/lint-scan-keywords.ts",
    "lint:bundle-quality": "tsx scripts/lint-bundle-quality.ts",
    "lint:bundles-synced": "tsx scripts/sync-bundles.ts --check",
    "lint:bundle-content": "tsx scripts/lint-bundle-content.ts",
    "lint:bundle-schema": "tsx scripts/lint-bundle-schema.ts",
    "lint:bundle-location-dupe": "tsx scripts/lint-bundle-location-dupe.ts",
    "lint:detector-registry": "pnpm --filter @cobblr/digifab gen:check",
    "lint:deprecated-fks": "tsx scripts/lint-deprecated-table-fks.ts",
    "lint:self-heal": "tsx scripts/lint-self-heal.ts",
    "lint:hook-timeouts": "tsx scripts/lint-hook-timeouts.ts",
    "lint:no-emdash": "tsx scripts/lint-no-emdash.ts",
    "lint:write-guards": "tsx scripts/lint-module-write-guards.ts",
    "lint:config-routes": "tsx scripts/lint-config-routes.ts",
    "lint:debug-globals": "tsx scripts/lint-debug-globals.ts",
    "lint:heal-shims": "tsx scripts/lint-heal-shims.ts",
    "lint:registry-headers-sync": "tsx scripts/lint-registry-headers-sync.ts",
    "lint:authed-media": "tsx scripts/lint-authed-media.ts",
    "lint:action-predicates": "tsx scripts/lint-action-predicates.ts",
    "lint:ai-reach": "tsx scripts/lint-ai-reach.ts",
    "lint:ai-coverage": "tsx scripts/lint-ai-coverage.ts",
    "lint:provider-labels": "tsx scripts/lint-provider-field-labels.ts",
    "lint:page-imports": "tsx scripts/lint-page-imports.ts",
    "lint:client-fetch-mounts": "tsx scripts/lint-client-fetch-mounts.ts",
    "lint:pagination": "tsx scripts/lint-pagination.ts",
    "lint:inline-overrides": "tsx scripts/lint-inline-style-overrides.ts",
    "lint:unit-conversion": "tsx scripts/lint-unit-conversion.ts",
    "lint:component-kinds": "tsx scripts/lint-generic-component-kinds.ts",
    "lint:consume-params": "tsx scripts/lint-consume-once-params.ts",
    "lint:ui-jargon": "tsx scripts/lint-ui-jargon.ts",
    "lint:empty-state-actions": "tsx scripts/lint-empty-state-actions.ts",
    "lint:browser-driver-pairs": "tsx scripts/lint-browser-driver-pairs.ts",
    "lint:ai-invoke": "tsx scripts/lint-ai-invoke.ts",
    "lint:jsonb-merge": "tsx scripts/lint-jsonb-merge.ts",
    "lint:control-bytes": "tsx scripts/lint-no-raw-control-bytes.ts",
    "lint:prompt-fingerprint": "tsx scripts/lint-ai-prompt-fingerprint.ts",
    "lint:workspace-vocab": "tsx scripts/lint-workspace-vocab.ts",
    "lint:no-passthrough": "tsx scripts/lint-no-passthrough.ts",
    "lint:catalog-schema-complete": "tsx scripts/lint-catalog-schema-complete.ts",
    "build": "pnpm -r run --if-present build",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "pnpm -r run --if-present test",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true; git config merge.semver-version.driver 'node scripts/merge-semver-version.mjs %O %A %B' 2>/dev/null || true",
    "typecheck:fast": "pnpm -r run --if-present typecheck:fast",
    "embed:bridge": "node scripts/embed-bridge-bundle.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "lint:native-field-labels": "node scripts/lint-native-field-labels.mjs",
    "lint:view-config-keys": "tsx scripts/lint-view-config-keys.ts",
    "lint:bench-not-shipped": "tsx scripts/lint-bench-not-shipped.ts",
    "lint:generated-artifact-paths": "tsx scripts/lint-generated-artifact-paths.ts"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "marked": "^14.1.4"
  },
  "packageManager": "pnpm@11.8.0"
}
