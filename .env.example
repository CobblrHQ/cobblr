# Cobblr — env template. Copy to .env for local dev.

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# Postgres — local dev points at the compose service.
# `cobblr_meta` is the platform-level DB; tenant DBs are provisioned
# at runtime by the platform with names like `tenant_<short_uuid>`.
DATABASE_URL=postgres://cobblr:cobblr@db:5432/cobblr_meta
# Superuser connection used only for CREATE DATABASE / CREATE USER
# when provisioning tenants. Keep this separate from the per-tenant
# connections.
SUPERUSER_DATABASE_URL=postgres://cobblr:cobblr@db:5432/postgres

# Auth — 64 bytes of base64-random for prod. The dev default below is
# fine to commit because it's only used locally.
JWT_SECRET=dev-only-do-not-use-in-prod-must-be-overridden
SESSION_TTL_DAYS=30

# AES-256-GCM key for encrypting tenant DB credentials at rest. Same
# rule: regenerate for prod, store in a secrets manager.
TENANT_CREDS_ENCRYPTION_KEY=dev-only-32-byte-key-replace-me!!

# ── Web ──────────────────────────────────────────────────────────────
# Local dev defaults to 8088 to leave 8080 free for other stacks.
WEB_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088

# ── Who this instance is, to other people's APIs ─────────────────────
# A few features call third-party services (filament QR lookups, book lookups).
# Those vendors ask for a way to reach whoever is running the software. This is
# YOUR address as the person hosting this instance - not Cobblr's, and not sent
# anywhere except on a call you triggered. Falls back to the first
# SUPERADMIN_EMAILS entry. With neither set, the lookups that require a contact
# address are skipped rather than sent under somebody else's name.
COBBLR_OPERATOR_EMAIL=

# ── Discord notifications & waitlist approvals (optional) ────────────
# The support bot (operator infra — source in the private cloud ops repo,
# ops/support-bot/) holds the Discord connection; the API
# pokes it. Set this to the bot's LAN URL to enable: waitlist Approve cards
# (Feature 0) AND the discord_dm notification channel (Feature 1).
# COBBLR_DISCORD_BOT_URL=http://<host-lan-ip>:8769
# Discord OAuth app (Feature 1 — "Connect Discord" in Communication
# Preferences). Without these the Discord DM column simply doesn't appear.
# Redirect defaults to <PUBLIC_BASE_URL>/api/v1/me/discord/oauth-callback.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# Invite link offered when a test DM is blocked by the user's privacy
# settings (joining a shared server unblocks DMs). Optional.
# DISCORD_INVITE_URL=

# ── Postgres (compose) ───────────────────────────────────────────────
POSTGRES_USER=cobblr
POSTGRES_PASSWORD=cobblr
POSTGRES_DB=cobblr_meta

# ── Extension registry / marketplace ─────────────────────────────────
# LEAVE BLANK. The official catalogs need no credential: the bundle index is
# built in-process from this image's own bundles, and the module registry is a
# public URL. This is only for pointing COBBLR_REGISTRY_URL /
# COBBLR_EXTENSIONS_URL at a PRIVATE index of your own, where it is sent as a
# bearer token.
COBBLR_REGISTRY_TOKEN=
# Notarised-open trust (Phase D): the PUBLIC ed25519 root key (base64).
# Generate the pair with `node scripts/keygen-root.mjs`; set the public
# half here, keep the private half in a secret manager. Leave blank to
# run the official lane unanchored (everything shows as "unverified").
COBBLR_ROOT_PUBKEY=
# Optional overrides (defaults point at cobblr-extensions/main/index.json):
# COBBLR_EXTENSIONS_URL=
# COBBLR_EXTENSIONS_SIG_URL=

# ── The barcode network ──────────────────────────────────────────────
# Where coverage beyond groceries, books, and music comes from: you get everyone
# else's corrections, and yours go back in. Off unless a URL is set; your own
# providers still handle anything it does not know, and an unreachable network
# never fails a scan. Get a per-install key at account.cobblr.xyz. Set both or
# neither: a URL with no key is refused on every lookup.
# COBBLR_BIDB_URL=https://barcodes.cobblr.xyz
# COBBLR_BIDB_KEY=

# ── Following parcels (FedEx) ────────────────────────────────────────
# Working out which carrier a tracking number belongs to is free and needs no
# setup. FOLLOWING the parcel needs that carrier's API, so connect the ones you
# use. Tracking APIs are free to call; only label and shipping APIs are gated.
#
# FedEx: developer.fedex.com -> create a project -> Basic Integrated Visibility
# (the tracking product, 100k calls/day). Register as yourself, tracking your
# own shipments. Offering FedEx tracking to OTHER people as part of a product
# you sell is their Integrator Program, which is a separate application.
#
# Test keys only answer for FedEx's own canned numbers, and return the same
# fixture for every number including ones that do not exist. Move the project
# to Production for real parcels, then set COBBLR_FEDEX_ENV=production.
# COBBLR_FEDEX_API_KEY=
# COBBLR_FEDEX_SECRET_KEY=
# COBBLR_FEDEX_ENV=production

# ── A tracking API (any carrier) ─────────────────────────────────────
# Every carrier API needs its own signup and most need a card, which is a wall
# no amount of driver-writing gets past. So core also speaks a general tracking
# API, and WHICH ENDPOINT is a separate knob from WHICH WIRE FORMAT -- the same
# split as the AI providers, where openai-compat talks to anything speaking that
# format.
#
# Default format is EasyPost's (flat JSON, HTTP Basic, per-tracker pricing with
# no monthly floor). Set the URL to any server that answers the same shape and
# core cannot tell the difference, which is how a local bridge works.
#
#   COBBLR_TRACKING_API      wire format; only "easypost" so far
#   COBBLR_TRACKING_API_URL  where it lives (default https://api.easypost.com/v2)
#   COBBLR_TRACKING_API_KEY  the key it wants
#
# A carrier's own driver wins where one is configured; this fills the gaps.
# COBBLR_TRACKING_API=easypost
# COBBLR_TRACKING_API_URL=https://api.easypost.com/v2
# COBBLR_TRACKING_API_KEY=
#
# How Cobblr REACHES that URL. Unset means fetch it directly, which is right
# for a public API. If the endpoint lives on your own network -- something you
# run at home -- a hosted Cobblr cannot reach it (private addresses are blocked
# and NAT would stop it anyway), so route it through your edge bridge instead:
# the bridge makes the call locally and the answer rides back. The bridge needs
# no support for this; it is handed the URL to fetch.
#   bridge         the workspace's bridge
#   bridge:<id>    a named one, if you run more than one
# COBBLR_TRACKING_API_TRANSIT=bridge

# How often to ask, in minutes. Unset uses a schedule that assumes asking is
# expensive: about daily while a parcel is travelling, three times on the day it
# is due, and never once it is delivered. Set a flat interval when you KNOW the
# endpoint is cheap -- a service whose reads are free, or a bridge on your own
# machine. A delivered parcel is never polled either way.
# COBBLR_TRACKING_POLL_INTERVAL=240
