# Cobblr — env template. Copy to .env for local dev.

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# Postgres — local dev points at the compose service.
# `cobblr_meta` is the platform-level DB; tenant DBs are provisioned
# at runtime by the platform with names like `tenant_<short_uuid>`.
DATABASE_URL=postgres://cobblr:cobblr@db:5432/cobblr_meta
# Superuser connection used only for CREATE DATABASE / CREATE USER
# when provisioning tenants. Keep this separate from the per-tenant
# connections.
SUPERUSER_DATABASE_URL=postgres://cobblr:cobblr@db:5432/postgres

# Auth — 64 bytes of base64-random for prod. The dev default below is
# fine to commit because it's only used locally.
JWT_SECRET=dev-only-do-not-use-in-prod-must-be-overridden
SESSION_TTL_DAYS=30

# AES-256-GCM key for encrypting tenant DB credentials at rest. Same
# rule: regenerate for prod, store in a secrets manager.
TENANT_CREDS_ENCRYPTION_KEY=dev-only-32-byte-key-replace-me!!

# ── Web ──────────────────────────────────────────────────────────────
# Local dev defaults to 8088 to leave 8080 free for other stacks.
WEB_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088

# ── Who this instance is, to other people's APIs ─────────────────────
# A few features call third-party services (filament QR lookups, book lookups).
# Those vendors ask for a way to reach whoever is running the software. This is
# YOUR address as the person hosting this instance - not Cobblr's, and not sent
# anywhere except on a call you triggered. Falls back to the first
# SUPERADMIN_EMAILS entry. With neither set, the lookups that require a contact
# address are skipped rather than sent under somebody else's name.
COBBLR_OPERATOR_EMAIL=

# ── Discord notifications & waitlist approvals (optional) ────────────
# The support bot (operator infra — source in the private cloud ops repo,
# ops/support-bot/) holds the Discord connection; the API
# pokes it. Set this to the bot's LAN URL to enable: waitlist Approve cards
# (Feature 0) AND the discord_dm notification channel (Feature 1).
# COBBLR_DISCORD_BOT_URL=http://<host-lan-ip>:8769
# Discord OAuth app (Feature 1 — "Connect Discord" in Communication
# Preferences). Without these the Discord DM column simply doesn't appear.
# Redirect defaults to <PUBLIC_BASE_URL>/api/v1/me/discord/oauth-callback.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# Invite link offered when a test DM is blocked by the user's privacy
# settings (joining a shared server unblocks DMs). Optional.
# DISCORD_INVITE_URL=

# ── Postgres (compose) ───────────────────────────────────────────────
POSTGRES_USER=cobblr
POSTGRES_PASSWORD=cobblr
POSTGRES_DB=cobblr_meta

# ── Extension registry / marketplace ─────────────────────────────────
# LEAVE BLANK. The official catalogs need no credential: the bundle index is
# built in-process from this image's own bundles, and the module registry is a
# public URL. This is only for pointing COBBLR_REGISTRY_URL /
# COBBLR_EXTENSIONS_URL at a PRIVATE index of your own, where it is sent as a
# bearer token.
COBBLR_REGISTRY_TOKEN=
# Notarised-open trust (Phase D): the PUBLIC ed25519 root key (base64).
# Generate the pair with `node scripts/keygen-root.mjs`; set the public
# half here, keep the private half in a secret manager. Leave blank to
# run the official lane unanchored (everything shows as "unverified").
COBBLR_ROOT_PUBKEY=
# Optional overrides (defaults point at cobblr-extensions/main/index.json):
# COBBLR_EXTENSIONS_URL=
# COBBLR_EXTENSIONS_SIG_URL=

# ── Shared barcode intelligence (BIdb) ───────────────────────────────
# A hosted database that answers a scanned barcode from pooled open data and
# community corrections. Off unless a URL is set; your own providers still handle
# anything it does not know, and an unreachable BIdb never fails a scan.
# NOT AVAILABLE YET - the service is not running and no keys are issued. Present
# so enabling it later is one line here, not a template migration.
# COBBLR_BIDB_URL=
# COBBLR_BIDB_KEY=
