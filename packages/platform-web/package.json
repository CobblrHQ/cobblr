{
  "name": "@cobblr/platform-web",
  "version": "0.12.39",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./floating-chrome.css": "./src/floating-chrome.css",
    "./json-field": {
      "types": "./src/JsonField.tsx",
      "import": "./src/JsonField.tsx"
    },
    "./blocked-action": {
      "types": "./src/blocked-action.ts",
      "import": "./src/blocked-action.ts"
    },
    "./product-name": {
      "types": "./src/product-name.ts",
      "import": "./src/product-name.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cobblr/platform-contract": "workspace:*",
    "@cobblr/thermal-print": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "qrcode": "^1.5.4",
    "react-markdown": "^9.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^0.469.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.7.2"
  }
