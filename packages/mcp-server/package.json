{
  "name": "@cobblr/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing a Cobblr install (cloud or self-hosted) to a local Claude Code / Claude Desktop / claude.ai connector.",
  "bin": {
    "cobblr-mcp": "dist/index.js",
    "cobblr-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
