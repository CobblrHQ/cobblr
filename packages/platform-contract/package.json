  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "^0.27.5",
    "@types/node": "^22.10.5",
    "re2js": "2.8.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
